void add_tile (float minx,float maxx,float miny,float maxy,float minz,float maxz,string text,int priority=0)
{
tm.add_area(minx, maxx, miny, maxy, minz, maxz, 0.0, "tile", text, "", "", priority);
}

void add_zone (float minx,float maxx,float miny,float maxy,float minz,float maxz,string text,int priority=0)
{
zm.add_area(minx, maxx, miny, maxy, minz, maxz, 0.0, "tile", text, "", "", priority);
}

string get_tile(float x,float y,float z,int priority=-1)
{
string t;
try
{
coordinate_map_area@ cma = tm.get_area(x, y, z, priority, 0.0, null,0 , 0);
t = cma.data1;
}
catch
{

}
return t;
}

string get_tile_at (float x,float y,float z,int priority=-1)
{
return get_tile (x,y,z,priority);
}

string get_zone(float x,float y,float z,int priority=-1)
{
string t;
try
{
coordinate_map_area@ cma = zm.get_area(x, y, z, priority, 0.0, null,0 , 0);
t = cma.data1;
}
catch
{

}
return t;
}

void load_map(string data)
{
in_map=false;
maploadtimer.restart();
sound loading;
loading.load("maploading.ogg");
loading.play_looped();
destroy_all_sources();
destroy_all_doors();
zm.reset();
tm.reset();
trm.reset();
zones.resize(0);
travel_point.resize(0);
string[]@ map_data = split_text (data,"\r\n" , "\n");
pos ();
for (uint i=0; i<map_data.length(); i++)
{
//pos ();
string[]@ parts = map_data[i].split(":");
if(parts[0] == "tile")
{
add_tile (string_to_number(parts[1]), string_to_number ( parts[2] ) , string_to_number (parts[3]) , string_to_number (parts[4]) , string_to_number (parts[5]) , string_to_number (parts[6]) , parts[7],i);
}
else if(parts[0] == "zone")
{
add_zone (string_to_number(parts[1]), string_to_number ( parts[2] ) , string_to_number (parts[3]) , string_to_number (parts[4]) , string_to_number (parts[5]) , string_to_number (parts[6]) , parts[7],i);
if(parts.length()>7) zones.insert_last(string_replace(map_data[i], "zone:", "", true));
}
else if(parts[0]=="src" and parts.length()>7)
{
int lx=string_to_number(parts[1]);
int rx=string_to_number(parts[2]);
int miny=string_to_number(parts[3]);
int maxy=string_to_number(parts[4]);
int minz=string_to_number(parts[5]);
int maxz=string_to_number(parts[6]);
int volume=0;
if (parts.length() >=10)
{
volume=string_to_number(parts[9]);
}
int id=-1;
spawn_source(lx, rx, miny, maxy, minz, maxz, parts[7], false, id , volume);
}
else if(parts[0]=="amb" and parts.length()>7)
{
create_amb(stn(parts[1]),stn(parts[2]),stn(parts[3]),stn(parts[4]),stn(parts[5]),stn(parts[6]),parts[7]);
}
else if(parts[0]=="door" and parts.length()>=12)
{
int x=string_to_number(parts[1]);
int y=string_to_number(parts[2]);
int z=string_to_number(parts[3]);
int fx=string_to_number(parts[4]);
int fy=string_to_number(parts[5]);
int fz=string_to_number(parts[6]);
int speed=string_to_number(parts[7]);
string snd1=parts[8];
string snd2=parts[9];
string snd3=parts[10];
string snd4=parts[11];
spawn_door(x, y, z, fx, fy,fz,speed,snd1,snd2,snd3,snd4);
}
else if(parts[0]=="mapname")
{
mapname = parts[1];
//msound_map_update();
}
else if(parts[0]=="maxx")
{
max.x=string_to_number(parts[1]);
}
else if(parts[0]=="maxy")
{
max.y=string_to_number(parts[1]);
}
else if(parts[0]=="maxz")
{
max.z=string_to_number(parts[1]);
}
}
loading.stop();
maploadtimer.pause();
in_map=true;
}

void zone_speak (float x,float y,float z)
{
string t = get_zone( x , y , z );
if(t!="")
{
if (t!=last_zone)
{
speak ( t );
last_zone = t;
send_reliable(0,"updatezone|"+last_zone,0);
}
}
else
{
t="uncharted area";
if(last_zone!=t)
{
speak (t);
last_zone = t;
}
}
}
void playstep()
{
int x=me.x, y=me.y, z=me.z;
onwall=false;
p.play_stationary(get_tile_at(mr.x,mr.y,me.z)+"step"+random(1,5)+".ogg",false);
}

void move(string dir)
{
if(dir==Up)
{
if(get_tile_at(mr.x, mr.y, me.z+1)!="")
{
me.z++;
checkup();
}
}
if(dir==Down)
{
if(get_tile_at(mr.x, mr.y, me.z-1)!="" and string_left(get_tile_at(mr.x,mr.y,me.z-1),4)!="wall")
{
me.z--;
checkdown();
}
}
if(dir==Forward)
{
double ox=me.x;
double oy=me.y;
me=move(me.x, me.y, me.z, facing, north);
if(round(me.x, 0)<0 or round(me.x, 0)>max.x or round(me.y, 0)<0 or round(me.y, 0)>max.y)
{
me.x=ox;
me.y=oy;
return;
}
checkaround(ox, oy);
}
if(dir==Backward)
{
double ox=me.x;
double oy=me.y;
me=move(me.x, me.y, me.z, facing, south);
if(round(me.x, 0)<0 or round(me.x, 0)>max.x or round(me.y, 0)<0 or round(me.y, 0)>max.y)
{
me.x=ox;
me.y=oy;
return;
}
checkaround(ox, oy);
}
if(dir==Left)
{
double ox=me.x;
double oy=me.y;
me=move(me.x, me.y, me.z, facing, west);
if(round(me.x, 0)<0 or round(me.x, 0)>max.x or round(me.y, 0)<0 or round(me.y, 0)>max.y)
{
me.x=ox;
me.y=oy;
return;
}
checkaround(ox, oy);
}
if(dir==Right)
{
double ox=me.x;
double oy=me.y;
me=move(me.x, me.y, me.z, facing, east);
if(round(me.x, 0)<0 or round(me.x, 0)>max.x or round(me.y, 0)<0 or round(me.y, 0)>max.y)
{
me.x=ox;
me.y=oy;
return;
}
checkaround(ox, oy);
}
update_player(me.x,me.y,me.z,mapname,name);
}

void checkaround(double ox, double oy)
{
mr.x=round(me.x, 0);
mr.y=round(me.y, 0);
if(string_contains(get_tile_at(mr.x, mr.y, me.z), "wall", 1)>-1)
{
double nx,ny,nz;
nx = me.x; ny = me.y; nz = me.z;
me.x=ox;
me.y=oy;
mr.x=round(ox,0);
mr.y=round(oy,0);
if(onwall==false)
{
onwall=true;
p.play_3d(get_tile_at(nx, ny, nz)+".ogg",mr.x , mr.y , me.z , nx , ny , nz , calculate_theta(facing), false);
send_reliable(0, "xplay|"+get_tile_at(nx,ny,nz), 0);
}
}
else
{
playstep();
send_reliable(0, "move_to|"+mr.x+"|"+mr.y+"|"+me.z, 0);
}
}
void checkup()
{
if(string_contains(get_tile_at(mr.x, mr.y, me.z), "wall", 1)>-1)
{
if(onwall==false)
{
onwall=true;
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+".ogg", false);
send_reliable(0, "xplay|"+get_tile_at(mr.x,mr.y,me.z), 0);
}
bounceback(Up);
}
else
{
playstep();
send_reliable(0, "move_to|"+mr.x+"|"+mr.y+"|"+me.z, 0);
}
}
void checkdown()
{
if(string_contains(get_tile_at(mr.x, mr.y, me.z), "wall", 1)>-1 and onwall==false)
{
if(onwall==false)
{
onwall=true;
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+".ogg", false);
send_reliable(0, "xplay|"+get_tile_at(mr.x,mr.y,me.z), 0);
}
bounceback(Down);
}
else
{
playstep();
send_reliable(0, "move_to|"+mr.x+"|"+mr.y+"|"+me.z, 0);
}
}
void bounceback(string d)
{
if(d==Up)
{
me.z--;
}
else if(d==Down)
{
me.z++;
}
}
string gmt()
{
return get_tile_at(me.x,me.y,me.z);
}
string gct()
{
return get_tile_at(round(camera.x,0), round(camera.y,0), camera.z);
}
void cameramove(string dir)
{
if(dir==Up)
{
camera.z++;
playcamera();
}
if(dir==Down)
{
camera.z--;
playcamera();
}
if(dir==Forward)
{
double ox=camera.x;
double oy=camera.y;
camera=move(camera.x, camera.y, camera.z, facing, north);
if(round(camera.x, 0)<0 or round(camera.x, 0)>max.x or round(camera.y, 0)<0 or round(camera.y, 0)>max.y)
{
camera.x=ox;
camera.y=oy;
return;
}
playcamera();
}
if(dir==Backward)
{
double ox=camera.x;
double oy=camera.y;
camera=move(camera.x, camera.y, camera.z, facing, south);
if(round(camera.x, 0)<0 or round(camera.x, 0)>max.x or round(camera.y, 0)<0 or round(camera.y, 0)>max.y)
{
camera.x=ox;
camera.y=oy;
return;
}
playcamera();
}
if(dir==Left)
{
double ox=camera.x;
double oy=camera.y;
camera=move(camera.x, camera.y, camera.z, facing, west);
if(round(camera.x, 0)<0 or round(camera.x, 0)>max.x or round(camera.y, 0)<0 or round(camera.y, 0)>max.y)
{
camera.x=ox;
camera.y=oy;
return;
}
playcamera();
}
if(dir==Right)
{
double ox=camera.x;
double oy=camera.y;
camera=move(camera.x, camera.y, camera.z, facing, east);
if(round(camera.x, 0)<0 or round(camera.x, 0)>max.x or round(camera.y, 0)<0 or round(camera.y, 0)>max.y)
{
camera.x=ox;
camera.y=oy;
return;
}
playcamera();
}
}
void playcamera()
{
for(uint i=0; i<players.length(); i++)
{
if(players[i].x==camera.x and players[i].y==camera.y and players[i].z==camera.z)
{
p.play_extended_3d("beacon.ogg", me.x, me.y, me.z, camera.x, camera.y, camera.z, calculate_theta(facing), 0, 0, 0, 0, 0,0,false, 0.0, 0.0, 0.0, 200.0);
}
for(uint i = 0; i < objs.length(); i++)
{
if(objs[i].x==camera.x&&objs[i].y==camera.y&&objs[i].z==camera.z&&objs[i].map==mapname)
{
p.play_extended_3d("obj.ogg", me.x, me.y, me.z, camera.x, camera.y, camera.z, calculate_theta(facing), 0, 0, 0, 0, 0,0,false, 0.0, 0.0, 0.0, 200.0);
speak (objs[i].amount+objs[i].name);
}
}
}
if (gct()=="")
{
p.play_3d("cameraair.ogg",me.x,me.y,me.z,camera.x,camera.y,camera.z,calculate_theta(facing), false);
}
else if (gct()=="hazard")
{
p.play_3d("camerahazard.ogg",me.x,me.y,me.z,camera.x,camera.y,camera.z,calculate_theta(facing), false);
}
else if (string_contains(gct(),"wall",1)>-1)
{
p.play_extended_3d(gct()+".ogg", me.x, me.y, me.z, camera.x, camera.y, camera.z, calculate_theta(facing), 0, 0, 0, 0, 0,0,false, 0.0, 0.0, 0.0, 80.0);
}
else
{
p.play_extended_3d(gct()+"step"+random(1,5)+".ogg", me.x, me.y, me.z, camera.x, camera.y, camera.z, calculate_theta(facing), 0, 0, 0, 0, 0,0,false, 0.0, 0.0, 0.0, 80.0);
}
}
int get_zone_index(string z)
{
int r=-1;
for(uint i=0; i<zones.length(); i++)
{
string[] parsed=string_split(zones[i],":",true);
if(parsed.length()>5)
{
if(parsed[6]==z)
{
r=i;
}
}
}
return r;
}
