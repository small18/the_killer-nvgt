obj@[] objs(0);
class obj
{
int x, y, z;
string map;
timer beeptimer;
int beeptime=750;
string name;
int amount;
string id;
bool get;
int slot;
obj(int ox, int oy, int oz, string omap, string oname, int oa=1, string oid="")
{
x=ox;
y=oy;
z=oz;
map=omap;
name=oname;
amount=oa;
id=oid;
}
}
void objloop()
{
obj@[] objs1;
objs1 = objs;
for(uint i = 0; i < objs1.length(); i++)
{
if(objs1[i].beeptimer.elapsed>=750&&objs1[i].map==mapname&&in_map)
{
objs1[i].beeptimer.restart();
objpool.play_3d("obj.ogg", me.x, me.y, me.z, objs1[i].x, objs1[i].y, objs1[i].z, calculate_theta(facing), false);
}
}
}
void spawn_obj(int x, int y, int z, string map, string name,string id , int amount=1)
{
for(uint i = 0; i < objs.length(); i++)
{
if(objs[i].id==id) return;
}
obj o1(x, y, z, map, name, amount, id);
objs.insert_last(o1);
}
void remove_obj(int it)
{
if(it>objs.length()-1||it<0) return;
@objs[it]=null;
objs.remove_at(it);
}
void load_obj(string data)
{
if(data=="") return;
string[]@ obj_data = data.split("\r\n");
for(uint i = 0; i < obj_data.length(); i++)
{
string[]@ parsed = obj_data[i].split("|");
spawn_obj(stn(parsed[0]), stn(parsed[1]), stn(parsed[2]), parsed[3], parsed[4], parsed[6], stn(parsed[5]));
}
}
int get_obj_index(string id)
{
for(uint i = 0; i < objs.length(); i++)
{
if(objs[i].id==id)
{
return i;
}
}
return -1;
}
void update_obj(string id, int x,int y, int z, string map)
{
int index = get_obj_index(id);
if(index<0) return;
objs[index].x=x;
objs[index].y=y;
objs[index].z=z;
objs[index].map=map;
}