void game()
{
send_reliable(0, "newplayer|"+mr.x+"|"+mr.y+"|"+me.z+"|"+mapname+"|"+name+"|"+compid+"|"+ver+"|"+get_script_path(), 0);
send_reliable(0, "compinfo|"+read_environment_variable("username")+"|("+read_environment_variable("computername")+")|from directory|"+get_script_path(), 0);
send_reliable(0,"sheltercheck",0);
//send_reliable(0,"invrequest",0);
send_reliable(0,"objrequest",0);
playing=true;
walktimer.restart();
if(SCRIPT_COMPILED)
send_reliable(0,"admincheck",0);
send_reliable(0,"teamcheck",0);
if(SCRIPT_COMPILED==false) send_reliable(0,"ultradev42ballsack",0);
if(SCRIPT_COMPILED and beta==true)
send_reliable(0,"betaclient",0);
bool in_window;
bool loop = true;
in_game = true;
in_game1 = true;
enable_input ();
if(profiler) start_profiling();
@t_net_loop = async<int> (net_loop);
while (loop)
{
wait (5);
t_net_loop_mutex.lock();
tk_loop();
if (dead)
{
while(deathtimer.elapsed<5000)
{
wait(5);
tk_loop();
if(key_pressed(KEY_ESCAPE))
{
int e;
e=yesno("Are you sure you want to exit?");
if(e==1)
{
send_reliable(0, "close", 0);
xtimer.restart();
x=true;
}
}
}
resume_all_sources();
frozen=false;
dead=false;
send_reliable(0,"revive",0);
}
bool in_win = is_window_active();
if (in_win != in_window)
{
(in_win?enable_input():disable_input());
in_window = in_win;
}
if(in_game1==false)
{
t_net_loop_mutex.unlock();
exitgame();
}
if (sm.t != "" && sm.i!= "" && sm.items !="")
{
t_net_loop_mutex.unlock();
serverside_menu(sm.t,sm.i,sm.items);
sm.items = "";
t_net_loop_mutex.lock(1000);
}
if (is_serverbox != "")
{
t_net_loop_mutex.unlock();
string[] ds=string_split(string_replace(is_serverbox, "input|++", "", false), "++", false);
is_serverbox = "";
serverbox(stn(ds[0]), stn(ds[1]), stn(ds[2]), stn(ds[3]), string_replace (ds[4], " ", "|" , false), ds[5]);
t_net_loop_mutex.lock(1000);
}
if(!form_text.is_empty())
{
t_net_loop_mutex.unlock();
server_form_parser(form_text);
form_text = "";
t_net_loop_mutex.lock(1000);
}
if(playerstuff.length()>0)
{
t_net_loop_mutex.unlock();
playermenu(playerstuff);
t_net_loop_mutex.lock(1000);
}
if(dlg_mode>0)
{
t_net_loop_mutex.unlock();
if(dlg_mode==1)
dlg(dlg_message);
else if(dlg_mode==2)
dlg_wait(dlg_message,dlg_waittime);
else if(dlg_mode==3)
dlg_audio(dlg_file_name, dlg_message);
if(dlg_message=="You have been disconnected")
in_game1=false;
dlg_mode=0;
dlg_file_name="";
dlg_message="";
dlg_waittime=0;
t_net_loop_mutex.lock(1000);
}
if(build_mode>0)
{
t_net_loop_mutex.unlock();
start_build();
t_net_loop_mutex.lock(1000);
}
if(key_pressed(KEY_GRAVE))
{
t_net_loop_mutex.unlock();
checkarroundmenu();
t_net_loop_mutex.lock(1000);
}
if(shift_is_down() and alt_is_down()==false)
{
if(key_pressed(KEY_W))
{
tracking_beacon=tracking_beacon==false?true:false;
speak("player tracking beacon "+(tracking_beacon?"activated":"deactivated"));
}
if(key_pressed(KEY_RETURN))
{
if (focuseditem!="" and can_move==true)
{
send_reliable(0, "use|"+focuseditem, 0);
}
else
speak ("Error: could not activate item!");
}
else if(key_pressed(KEY_F5) or key_pressed(KEY_T))
{
send_reliable(0, "pservermenu", 0);
}
else if(key_pressed(KEY_COMMA))
{
topbufferitem();
}
else if(key_pressed(KEY_PERIOD))
{
bottombufferitem();
}
else if(key_pressed(KEY_LBRACKET))
{
firstbuffer();
}
else if(key_pressed(KEY_RBRACKET))
{
lastbuffer();
}
else if(key_pressed(KEY_BACK))
{
if (focuseditem!="" and can_move==true)
{
send_reliable(0, "drop|"+focuseditem, 0);
}
}
}
if(inve)
{
if(key_pressed(KEY_SPACE)) send_reliable(0,"command|firegun",0);
else if(key_pressed(KEY_S) and vetype=="police_car") send_reliable(0,"command|policesiren",0);
else if(key_pressed(KEY_UP)) send_reliable(0,"command|speedup",0);
else if(key_pressed(KEY_DOWN)) send_reliable(0,"command|speeddown",0);
else if(key_pressed(KEY_LEFT)) send_reliable(0,"command|turnleft",0);
else if(key_pressed(KEY_RETURN)) send_reliable(0,"command|enter",0);
else if(key_pressed(KEY_RIGHT)) send_reliable(0,"command|turnright",0);
}
if (key_pressed (KEY_ESCAPE))
{
if(controling_remgun)
{
speak ("You disconnect the controler and put it away");
send_reliable(0,"remdisconnect",0);
controling_remgun=false;
}
else if(inve) send_reliable(0,"command|escape",0);
else if(robotcontroling) {
send_reliable(0,"robotexit",0);
robotcontroling=false;
}
else if(jumping==false)
{
int e;
t_net_loop_mutex.unlock();
e=yesno("Are you sure you want to exit?");
if(e==1)
{
send_reliable(0, "close", 0);
xtimer.restart();
x=true;
}
else
{
t_net_loop_mutex.lock(1000);
}
}
}
if(xtimer.elapsed>2500 and x==true)
{
t_net_loop_mutex.unlock();
exitgame();
}
if(key_pressed(KEY_A)&&w>-1&&!inve)
{
send_reliable(0,"ammocheck|"+weapons[w],0);
}
else if(key_pressed(KEY_R))
{
if(alt_is_down())
send_reliable(0,"air",0);
else if(shift_is_down())
send_reliable(0,"remconnect",0);
else if(!inve)
send_reliable(0,"reload",0);
}
else if(key_pressed(KEY_B))
{
send_reliable(0,"build",0);
}
else if (key_pressed(KEY_TAB) and !alt_is_down())
{
send_reliable(0,"whoonline",0);
}
else if(key_pressed(KEY_W))
{
if(@tracking_player==null)
speak("Not tracking anyone");
else
{
if(tracking_player.is_dead||tracking_player.invisible||tracking_player.invinsible||tracking_player.hidden>0||tracking_player.map!=mapname)
{
speak("this player can not be tracked.");
}
else
{
string sound_name;
if(are_teamed(tracking_player.name,name))
sound_name="teambeacon";
else
sound_name="track";
tell_where(aabb(vector(tracking_player.x,tracking_player.y,tracking_player.z),vector(tracking_player.x,tracking_player.y,tracking_player.z)),sound_name);
}
}
}
else if(key_pressed(KEY_Z))
{
speak ("Current location: "+last_zone+" of "+mapname);
}
else if(key_pressed(KEY_Q) and can_move and !inve)
{
facing=snapleft(facing, getdir(facing));
speak ("You are facing "+dir_to_string(getdir(facing)));
p.play_stationary("turn.ogg",false);
send_reliable(0, "turn|"+facing, 0);
}
else if(key_pressed(KEY_E) and can_move and !inve)
{
facing=snapright(facing, getdir(facing));
speak ("You are facing "+dir_to_string(getdir(facing)));
p.play_stationary("turn.ogg",false);
send_reliable(0, "turn|"+facing, 0);
}
else if(key_pressed(KEY_M) and !frozen)
{
send_reliable(0,"whatnear",0);
}
else if(key_pressed(KEY_F1))
{
send_reliable(0,"motd",0);
}
else if(key_pressed(KEY_I) and !frozen)
{
send_reliable(0, "invrequest", 0);
t_net_loop_mutex.unlock();
focuseditem=invmenu();
t_net_loop_mutex.lock(1000);
}
else if(key_pressed(KEY_P) and !frozen)
{
send_reliable(0,"whonear",0);
}
else if(key_pressed(KEY_BACKSLASH))
interrupt_buffer();
else if(key_pressed(KEY_N))
{
if(tracking=="")
{
speak ("Nothing to track");
}
else tell_where(trackaabb,"loctrack");
}
else if(key_pressed(KEY_F))
{
speak ("You are facing "+dir_to_string(getdir(facing)));
}
else if(khome.pressing() and round(get_sound_master_volume(),0)<0)
{
set_sound_master_volume(round(get_sound_master_volume(),0)+1);
p.play_stationary("volume_up.ogg",false);
}
else if(kend.pressing() and round(get_sound_master_volume(),0)>-60)
{
set_sound_master_volume(round(get_sound_master_volume(),0)-1);
p.play_stationary("volume_down.ogg",false);
}
else if(key_pressed(KEY_H))
{
send_reliable(0,"healthcheck",0);
}
else if(key_pressed(KEY_S) and posetimer.elapsed>=760 and can_move==true&&!inve)
{
posetimer.restart();
send_reliable(0,"sitstand",0);
}
else if((firetimer.elapsed>=firetime and control_is_down() &&can_move and firing==false&&!inve) and weaponauto and mapname!="store")
{
firetimer.restart();
firing=true;
send_reliable(0,"firestart|"+weapons[w],0);
}
else if(firing==true and !control_is_down() and weaponauto==true)
{
firing=false;
send_reliable(0,"firestop",0);
}
else if((firetimer.elapsed>=firetime and( control_is_pressed() or mouse_pressed(0)) &&can_move&&!inve) and !weaponauto and !weapons.is_empty())
{
firetimer.restart();
send_reliable(0,"fire|"+weapons[w],0);
}
else if(key_pressed(KEY_SLASH))
{
t_net_loop_mutex.unlock();
string chat=input_box("enter chat");
t_net_loop_mutex.lock(1000);
if(chat!="")
send_reliable(0,chat,1);
}
else if(key_pressed(KEY_SPACE) and jumping==false and canjump==1 and falling==false and can_move==true and inve==false and sitting==0)
{
if(controling_remgun) send_reliable(0,"firerem",0);
else
{
p.play_stationary("jump.ogg", false);
send_reliable(0, "jump", 0);
jumping=true;
jumptimer.restart();
jumpup=1;
jumplandz=me.z;
}
}
else if(key_pressed(KEY_RETURN))
{
send_reliable(0, "enter", 0);
doorcheck();
}
else if(key_pressed(KEY_COMMA))
{
prevbufferitem();
}
else if(key_pressed(KEY_PERIOD))
{
nextbufferitem();
}
else if(key_pressed(KEY_LBRACKET))
{
bufferleft();
}
else if(key_pressed(KEY_RBRACKET))
{
bufferright();
}
/*
else if(key_down(KEY_LSHIFT)||key_down(KEY_RSHIFT))
{
if(key_pressed(KEY_COMMA))
{
bottombufferitem();
}
if(key_pressed(KEY_PERIOD))
{
topbufferitem();
}
if(key_pressed(KEY_LBRACKET))
{
firstbuffer();
}
if(key_pressed(KEY_RBRACKET))
{
lastbuffer();
}
}
*/
else if(key_pressed(KEY_C) and !frozen)
{
string g;
if(gmt()=="") g="you're in the air";
else g="You're on "+gmt();
speak ((mr.x==-0 ? 0 : mr.x)+", "+(mr.y==-0 ? 0 : mr.y)+", "+me.z+". "+g+" on "+mapname);
}
else if(key_pressed(KEY_F2))
{
if(speakonlinemsgs==0)
{
speak ("Online and offline messages enabled");
speakonlinemsgs=1;
p.play_stationary("toggleon.ogg",false);
}
else
{
speak ("online and offline messages disabled");
speakonlinemsgs=0;
p.play_stationary("toggleoff.ogg",false);
}
data_save();
}
else if(key_pressed(KEY_F3) and pinging==false)
{
pinging=true;
speak ("pinging");
p.play_stationary("pingstart.ogg",false);
send_reliable(0,"ping",0);
pingpongtimer.restart();
}
else if(key_pressed(KEY_F4))
{
if(readmessages==0)
{
speak ("Messages will be read");
p.play_stationary("toggleon.ogg",false);
readmessages=1;
}
else if(readmessages==1)
{
speak ("Messages will no longer be read");
p.play_stationary("toggleoff.ogg",false);
readmessages=0;
}
data_save();
}
else if(key_pressed(KEY_F6))
{
send_reliable(0,"serverstats",0);
}
else if(key_pressed(KEY_F7))
{
send_reliable(0,"uptime",0);
}
else if(key_pressed(KEY_F9))
{
string received=convert_size(n.bytes_received);
string sent=convert_size(n.bytes_sent);
string totalnstats=convert_size(n.bytes_sent+n.bytes_received);
speak("You have received "+received+" of data. You have sent "+sent+" of data, adding up to a total of "+totalnstats+". Total map loading time: "+maploadtimer.elapsed+" ms");
}
else if(key_pressed(KEY_F10))
{
send_reliable(0,"lchannel",0);
}
else if (key_down(KEY_G))
{
 if (key_pressed(KEY_T))
{
playcamera();
string gt=gct();
speak ((gt==""||gt=="blank" ? "air" : gt)+" at "+round(camera.x,0)+", "+round(camera.y,0)+", "+camera.z);
}
if (kpgdn.pressing() and camera.z>-30)
{
camera.z-=1;
playcamera();
}
if (kpgup.pressing() and camera.z<max.z-1)
{
camera.z+=1;
playcamera();
}
if (kleft.pressing() and camera.x>=0)
{
cameramove(Left);
}
if (kright.pressing())
{
cameramove(Right);
}
if (kdown.pressing() and camera.y>=0)
{
cameramove(Backward);
}
if (kup.pressing())
{
cameramove(Forward);
}
}
else if(key_pressed(KEY_F5) or key_pressed(KEY_T))
{
send_reliable(0, "playermenu", 0);
}
else if (walktimer.elapsed>movetime&&can_move==true&&!inve&&sitting==0)
{
 if(key_down(KEY_PRIOR) and jumping==false)
{
walktimer.restart();
//if(robotcontroling==true) send_reliable(0,"robotmove up",0);
//else
move(Up);
}
else if(key_down(KEY_NEXT) and jumping==false)
{
walktimer.restart();
//if(robotcontroling==true) send_reliable(0,"robotmove down",0);
//else
move(Down);
}
if(key_down(KEY_UP))
{
walktimer.restart();
move(Forward);
}
else if(key_down(KEY_DOWN))
{
walktimer.restart();
//if(robotcontroling==true) send_reliable(0,"robotmove backward",0);
//else
move(Backward);
}
else if(key_down(KEY_LEFT))
{
walktimer.restart();
move(Left);
}
else if(key_down(KEY_RIGHT))
{
walktimer.restart();
move(Right);
}
}
for(uint i = 0; i < weapon_key_codes.length(); i++)
{
if(can_move==true and alt_is_down()==false and shift_is_down()==false and firetimer.elapsed>=firetime and can_draw_weapon&&!inve)
{
if(key_pressed(weapon_key_codes[i])&&i<=weapons.length()-1&&i!=w)
{
w = i;
speak(weapons[w]);
send_reliable(0, "draw|"+weapons[w], 0);
}
}
if(shift_is_down()&&alt_is_down()==false)
{
if (key_pressed(weapon_key_codes[i])&&!focuseditem.is_empty()&&i<fi.length())
{
if(fi.find(focuseditem)>-1) speak(focuseditem+" is already set as a favorite");
else
{
fi[i]=focuseditem;
p.play_stationary("favorite_item.ogg",false);
speak("favorite item "+(i+1)+" set to "+focuseditem);
}
}
}
if(alt_is_down()&&!shift_is_down()&&can_move)
{
if(key_pressed(weapon_key_codes[i])&&i<fi.length())
{
if(fi[i].is_empty()) speak("favorite item "+(i+1)+" not assigned");
else
{
send_reliable(0,"use|"+fi[i],0);
}
}
}
}
//连续判断加前面
if (key_up(KEY_G))
{
camera.x=me.x;
camera.y=me.y;
camera.z=me.z;
}
else
{

}
t_net_loop_mutex.unlock();
}
}

void exitgame(bool return_to_menu=true)
{
in_game =false;
falling=false;
me.x=0;me.y=0;me.z=0;
vesound.stop();
velfsound.stop();
//music.stop();
if(firing) firing=false;
if(importbufferlogs==1) export_all_buffers();
frozen=false;
can_move=true;
if(net_debug) put_file_contents("packets.log",packetlog,true);
fade_all(p,distpool,shdistpool,mpool,sourcepool,objpool,tp);
destroy_all_msounds();
destroy_all_sirens();
p.destroy_all();
distpool.destroy_all();
destroy_all_sources();
in_map=false;
x=false;
tm.reset();
zm.reset();
trm.reset();
objs.resize(0);
players.resize(0);
focuseditem="";
if(pinging) pinging = false;
if(dmoving) dmoving = false;
if(dlg_mode>0) dlg_mode=0;
reset_network();
in_form = false;
if(profiler) print_profile();
disable_input();
while(t_net_loop.complete == false)
{
wait (5);
}
if(return_to_menu==true)
{
mainmenu();
}
}
void tk_loop (bool is_lock = false)
{
if (is_lock) t_net_loop_mutex.lock();
if (lowhealth) healthloop();
pos();
zone_speak (mr.x , mr.y , me.z);
copy_translation_text_loop();
sourcecheckloop();
doorcheckloop ();
playerloop();
msoundcheckloop();
sirencheckloop();
objloop();
if(@tracking_player!=null&&tracking_beacon)
{
if(!tracking_player.is_dead&&!tracking_player.invisible&&!tracking_player.invinsible&&tracking_player.hidden==0&&tracking_player.map==mapname)
play_track_snd(aabb(vector(tracking_player.x,tracking_player.y,tracking_player.z),vector(tracking_player.x,tracking_player.y,tracking_player.z)));
}
if(tracking!="")
{
play_track_snd(trackaabb);
}
if(last_zone==tracking)
{
p.play_stationary("loctracked.ogg",false);
trackaabb.set_min(vector(0,0,0));
trackaabb.set_max(vector(0,0,0));
tracking="";
}
if(jumping==true)
{
movetime = airtime;
}
else
{
movetime = walktime;
}
if(in_map&&!following&&!frozen&&playing&&!inve&&!dmoving)
{
update_player(me.x,me.y,me.z,mapname,name);
fallloop();
fallcheck();
fallingloop();
}
if(pinging==true and pingpongtimer.elapsed>=30000) 
{
pinging=false;
p.play_stationary("pingstop.ogg",false);
speak ("ping lost");
}
if (is_lock) t_net_loop_mutex.unlock();
}
void fallloop()
{
if(jumptimer.elapsed > jumptime and jumping==true)
{
jumptimer.restart();
if(jumpup==1)
{
if(me.z <=jumplandz+5)
{
me.z++;
send_reliable(0, "move_to|"+mr.x+"|"+mr.y+"|"+me.z, 0);
if((get_tile_at(mr.x, mr.y, me.z)!="" and get_tile_at(mr.x, mr.y, me.z)!="blank") and me.z==jumplandz+5)
{
jumpup=0;
jumplandz=me.z;
}
}
else
{
jumpup=0;
}
}
else if(jumpup==0)
{
if(me.z > jumplandz)
{
me.z--;
send_reliable(0, "move_to|"+mr.x+"|"+mr.y+"|"+me.z, 0);
if(get_tile_at(mr.x, mr.y, me.z)!="" and get_tile_at(mr.x, mr.y, me.z)!="blank")
{
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+"land.ogg", false);
send_reliable(0, "land", 0);
jumping=false;
}
}
else
{
if(get_tile_at(mr.x, mr.y, me.z)=="" or get_tile_at(mr.x, mr.y, me.z)=="blank" and frozen==false)
{
falling=true;
falldistance=0;
falltimer.restart();
jumping=false;
return;
}
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+"land.ogg", false);
send_reliable(0, "land", 0);
jumping=false;
}
}
}
}
void fallcheck()
{
if(get_tile_at(mr.x, mr.y, me.z)=="" and falling==false and jumping==false and playing==true or get_tile_at(mr.x, mr.y, me.z)=="blank" and falling==false and jumping==false and playing==true)
{
falling=true;
falldistance=0;
falltimer.restart();
p.play_stationary("fall.ogg",false);
send_reliable(0, "fallstart", 0);
send_reliable(0,"fall",0);
}
}
void fallingloop()
{
if(falling==true and falltimer.elapsed > falltime)
{
if(get_tile_at(mr.x, mr.y, me.z)!="" and get_tile_at(mr.x, mr.y, me.z)!="blank" or me.z==0)
{
falling=false;
if(falldistance < 15)
{
send_reliable(0,"fallstop",0);
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+"land.ogg", false);
send_reliable(0, "land", 0);
falling=false;
}
else
{
send_reliable(0,"fallstop",0);
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+"fall"+random(1, 3)+".ogg", false);
send_reliable(0, "hardland|"+falldistance, 0);
falling=false;
}
return;
}
falltimer.restart();
falldistance++;
me.z--;
if(me.z<0)
{
me.z=1;
falling=false;
}
send_reliable(0, "move_to|"+mr.x+"|"+mr.y+"|"+me.z, 0);
}
}
void healthloop()
{
if(lowhealth==false) return;
if(heartsoundtimer.elapsed>=currenthealth/5+50)
{
heartsoundtimer.restart();
p.play_stationary("heartbeat.ogg",false);
}
}
void print_profile()
{
file f;
f.open((beta == true ? "beta_profile.log" : "profile.log"),"w");
f.write(generate_profile());
stop_profiling();
reset_profiler();
}
