void enable_input()
{
    inputmethod.load("imm32.dll");
    
    uint64 prev = inputmethod.call(
        "uint64 ImmAssociateContext(uint64, uint64)",
        get_window_os_handle(),
        0
    );

    imm = prev;
}
void disable_input()
{
inputmethod.load("imm32.dll");
inputmethod.call("void ImmAssociateContext(uint64 , uint64 )",get_window_os_handle(),imm);
}