//string netaddress="127.0.0.1";
string netaddress="pro.xztom.com";
uint64 netport = 10000;

void login ()
{
if (name == "" or pass == "")
{
p.play_stationary("progress.ogg",false);
dlg("error! No account configured. Please click setup an account, or create a new one");
mainmenu();
return;
}
if(connected==false or prior_connected==false)
{
if(SCRIPT_COMPILED==false||beta==true)
{
speak ("connecting to "+netaddress+"...");
}
else
{
speak ("Attempting to connect...");
}
if(n.active)
{
reset_network();
}
n.setup_client(500, 500);
p.play_stationary ("connected.ogg",false);
n.connect(netaddress, netport);
if(get_last_error()!=0)
{
alert("error","network failed to initialize. Error code: "+get_last_error());
exit();
}
}
if(connected==true or prior_connected==true)
{
e=n.request();
send_reliable(0, "login|"+name+"|"+pass+"|"+netver+"|"+compid, 0);
}
timeouttimer.restart();
while(true)
{
wait(5);
e=n.request();
if (key_pressed(KEY_ESCAPE))
{
mainmenu();
}
if(e.type==event_connect and connected==false)
{
peer_id=e.peer_id;
speak ("logging in...");
send_reliable(0, "login|"+name+"|"+pass+"|"+netver+"|"+compid, 0);
connected=true;
}
else if(e.type==event_receive)
{
string s = get_event_message(e.message);
if(s=="admin")
{
speak ("You are an admin");
admin=true;
}
if(s=="nochar")
{
reset_network();
p.play_stationary("progress.ogg",false);
dlg("error: This account does not exist!");
mainmenu();
}
if(s=="wrongpass")
{
reset_network();
p.play_stationary("progress.ogg",false);
dlg("Your password doesn't match the one that is on the server.");
mainmenu();
}
if(s=="alreadyplaying")
{
reset_network();
p.play_stationary("progress.ogg",false);
dlg("sorry: this account is already logged in");
mainmenu();
}
if(string_contains(s,"error",1)>-1)
{
reset_network();
p.play_stationary("progress.ogg",false);
dlg(get_event_message(e.message));
mainmenu();
}
if(s=="error" or(timeouttimer.elapsed>=timeouttime))
{
reset_network();
p.play_stationary("progress.ogg",false);
dlg("Server is offline");
mainmenu();
}
if(s=="banned")
{
if(SCRIPT_COMPILED)
{
reset_network();
p.play_stationary("progress.ogg",false);
dlg("error, You are currently banned from the game. please try again later");
mainmenu();
}
else
{
dlg("You would be banned, but you're a dev!");
}
}
string[] parsed=s.split(" ");
if(parsed.length()>1)
{
if(parsed[0]=="block")
{
reset_network();
p.play_stationary("progress.ogg",false);
dlg(string_trim_left(s,6));
mainmenu();
}
if(parsed[0]=="x")
{
me.x=string_to_number(parsed[1]);
}
else if(parsed[0]=="oldversion" and parsed.length()>1)
{
reset_network();
p.play_stationary("progress.ogg",false);
dlg("error, you are running a different version than the one on the server. Please redownload the game at http://ims-productions.com. Your version: "+netver+". Latest version: "+parsed[1]);
mainmenu();
}
else if(parsed[0]=="y")
{
me.y=string_to_number(parsed[1]);
}
else if(parsed[0]=="z")
{
me.z=string_to_number(parsed[1]);
}
else if(parsed[0]=="mapname")
{
mapname=string_replace(s,"mapname ","",false);
}
else if(parsed[0]=="mdata")
{
//load_map(string_replace(s, "mdata ", "", false));
}
else if(parsed[0]=="motd")
{
motd=string_trim_left(s,6);
}
else if(parsed[0]=="m_data")
{
load_map(string_replace(get_event_message(e.message), "mdata ", "", false));
}
else if(parsed[0]=="facing")
{
facing=string_to_number(parsed[1]);
}
}
else if(s=="loggedin")
{
p.update_listener_3d(me.x, me.y, me.z);
sourcecheckloop();
mr.x=round(me.x,0);mr.y=round(me.y,0);
game();
}
}
}
}

void reset_network(){ 
n.disconnect_peer(0);
timeouttimer.restart();
peer_id=0;
n.destroy();
prior_connected=false;
connected=false;
}
/*
void send_reliable(uint peer, string mess, uint channel)
{
async<void> call (send_reliablexc,peer,mess,channel);
sent_packets+=1;
}
void send_unreliable(uint peer, string mess, uint channel)
{
async<void> call (send_unreliablexc,peer,mess,channel);
sent_packets+=1;
}
*/
void send_reliable(uint peer, string mess, uint channel)
{
if(net_debug) packetlog+=">"+mess+"\r\n";
mess=string_encrypt(mess, "ivanlovesplayigtkdoesn'theheheheheheheheheheheheheheheheheheheheh42");
mess = string_deflate(mess,9);
n.send_reliable(peer, mess, channel);
sent_packets+=1;
}
void send_unreliable(uint peer, string mess, uint channel)
{
if(net_debug) packetlog+=">"+mess+"\r\n";
mess=string_encrypt(mess, "ivanlovesplayigtkdoesn'theheheheheheheheheheheheheheheheheheheheh42");
mess = string_deflate(mess,9);
n.send_unreliable(peer, mess, channel);
sent_packets+=1;
}
string get_event_message(string r)
{
if(r=="")
{
return "";
}
r = string_inflate(r);
r=string_decrypt(r, "ivanlovesplayigtkdoesn'theheheheheheheheheheheheheheheheheheheheh42");
received_packets+=1;
if(net_debug) packetlog+="<"+r+"\r\n";
return r;
}


int net_loop()
{
while (in_game)
{
wait (1);
//garbage_collect();
t_net_loop_mutex.lock();
string s;
e = n.request(0);
if (e.type==event_disconnect)
{
dlg_message="You have been disconnected";
dlg_mode=1;
prior_connected=false;
}
if(e.type==event_receive)
{
//file_put_contents("net.log", get_event_message(e.message) + "\r\n" , FILE_APPEND);
if(e.channel==0)
{
s = get_event_message(e.message);
if (s=="")
{
t_net_loop_mutex.unlock();
continue;
}
string[] parsed = s.split("|");
if (parsed.length()<1)
{
t_net_loop_mutex.unlock();
continue;
}
if (parsed[0]=="map" && parsed.length() >=2)
{
load_map(parsed[1]);
}
else if(parsed[0]=="jump")
{
int x=stn(parsed[2]);
int y=stn(parsed[3]);
int z=stn(parsed[4]);
string map=parsed[5];
if(parsed[1]!=name and map==mapname and inve==false)
{
tp.play_3d("jump.ogg", me.x, me.y, me.z, x, y, z, calculate_theta(facing), false);
}
}
else if(parsed[0]=="fall")
{
int x=stn(parsed[2]);
int y=stn(parsed[3]);
int z=stn(parsed[4]);
string map=parsed[5];
 if(parsed[1]!=name and map==mapname and inve==false)
{
tp.play_3d("fall.ogg",me.x,me.y,me.z,x,y,z,calculate_theta(facing),false);
}
}
else if(parsed[0]=="trackplayer")
{
int x=round(stn(parsed[2]),0);
int y=round(stn(parsed[3]),0);
int z=stn(parsed[4]);
string mp=parsed[5];
if(mapname!=mp)
speak("This player is on a different map. Sorry");
else
{
tell_where(aabb(vector(x,y,z),vector(x,y,z)),parsed[6],true);
}
}
else if(parsed[0]=="facing"&&parsed.length () >1) facing=stn(parsed[1]);
else if(parsed[0]=="land")
{
int x=stn(parsed[2]);
int y=stn(parsed[3]);
int z=stn(parsed[4]);
string map=parsed[5];
if(parsed[1]!=name and map==mapname and inve==false)
{
tp.play_3d(get_tile_at(x, y, z)+"land.ogg", me.x, me.y, me.z, x, y, z, calculate_theta(facing), false);
}
}
else if(parsed[0]=="draw" and parsed.length()>1)
{
if(weapons.find(parsed[1])<0)
{
weapons.insert_last(parsed[1]);
}
int index = weapons.find(parsed[1]);
if(index<0)
{
w=(weapons.length()-1);
}
else
{
w=index;
}
speak(weapons[w]);
send_reliable(0,"draw|"+weapons[w],0);
}
else if(parsed[0]=="clip")
{
clipboard_set_text(s.substr(5));
}
else if(parsed[0]=="remcontrol")
{
speak("You pull out a remote controler. Its  small with a button in the center with the letter F. You see a small flashing light indicating a remote gun is sending a signal");
controling_remgun=true;
}
else if(parsed[0]=="update_player_teamname"&&parsed.length()>=3)
{
int index = get_player_index_from(parsed[1]);
if(index>-1)
{
if(parsed[2]=="[empty]")
{
players[index].teamname="";
}
else
{
players[index].teamname=parsed[2];
}
}
}
else if(parsed[0]=="launch_form"&&parsed.length()>=1)
{
string ftext = s;
ftext = ftext.replace("launch_form|","",false);
form_text = ftext;
}
else if(parsed[0]=="form_dismiss")
{
in_form = false;
}
else if(parsed[0]=="cannotdraw")
{
can_draw_weapon=false;
}
else if(parsed[0]=="candraw")
{
can_draw_weapon=true;
}
else if(parsed[0]=="remove_obj"&&parsed.length()>1)
{
int index = get_obj_index(parsed[1]);
if (index>-1)
remove_obj(parse_int(index));
}
else if(parsed[0]=="spawn_players")
{
if(parsed.length()>=2) load_players(s);
}
else if(parsed[0]=="spawn_obj")
{
spawn_obj(stn(parsed[1]), stn(parsed[2]), stn(parsed[3]), parsed[4], parsed[5], parsed[7], stn(parsed[6]));
}
else if(parsed[0]=="load_obj" and parsed.length()>=1)
{
string data = string_replace(s,"load_obj|","",false);
load_obj(data);
}
else if(parsed[0]=="weaponlist" and parsed.length()>1)
{
weapons.resize(0);
w=-1;
for(uint i=1; i<parsed.length(); i++)
{
weapons.insert_last(parsed[i]);
}
}
else if(parsed[0]=="weapondata" and parsed.length()>=2)
{
string text = s.replace("weapondata|","");
json_object@ j = parse_json(text);
if(@j!=null)
{
string[] k = j.get_keys();
for(uint i = 0; i < k.length(); i++)
{
if(k[i]=="fire_time")
firetime=j["fire_time"];
if(k[i]=="fire_mode")
weaponauto=(j["fire_mode"]=="auto" ? true : false);
if(k[i]=="walk_time")
{
walkmod=true;
walktime=j["walk_time"];
airtime=(j["walk_time"]/2);
movetime=walktime;
walktimer.restart();
}
if(!j.exists("walk_time"))
{
walkmod=false;
walktime=100;
movetime=walktime;
airtime=50;
}
if(k[i]=="can_jump")
{
canjump=j["can_jump"];
}
if(!j.exists("can_jump"))
{
canjump=1;
}
}
}
}
else if(parsed[0]=="followstart")
{
can_move=false;
following=true;
}
else if(parsed[0]=="followstop")
{
can_move=true;
following=false;
}
else if(parsed[0]=="play_step"&&parsed.length()>=7)
{
int x = parse_double(parsed[2]);
int y = parse_double(parsed[3]);
int z = parse_double(parsed[4]);
string map = parsed[5];
string tile = parsed[1];
string pname = parsed[6];
if(tile=="[empty]") tile="";
update_player(x,y,z,map,pname);
if(mapname==map&&!tile.is_empty())
{
mpool.play_3d(tile+"step"+random(1,5)+".ogg",me.x,me.y,me.z,x,y,z,calculate_theta(facing),false);
}
}
else if(parsed[0]=="set_player_value"&&parsed.length()>=4)
{
set_player_value(parsed[1],parsed[2],parsed[3]);
}
else if(parsed[0]=="invstring")
{
inv=string_decompress(string_trim_left(s, 10));
invchanged=true;
}
else if (parsed[0]=="inv" and parsed.length()>=3)
{
send_reliable(0,s,0);
}
else if(parsed[0]=="offline" and parsed.length()>1)
{
if(parsed[4]==name)
{
in_game1 = false;
x=false;
//exitgame(true);
//continue;
}
int x=stn(parsed[1]);
int y=stn(parsed[2]);
int z=stn(parsed[3]);
string n=parsed[4];
string m=parsed[5];
int index = get_player_index_from(n);
if(parsed[4]!=name&&index>-1)
{
if(speakonlinemsgs==1&&players[index].hidden==0)
{
tp.play_stationary("offline.ogg", false);
add_buffer_item("misc",parsed[4]+" just went offline");
}
}
remove_player(n);
}
else if(parsed[0]=="admintell")
{
if(!SCRIPT_COMPILED or admin==true)
{
string alert;
alert=s.replace("admintell|","",false);
tp.play_stationary("admintell.ogg",false);
add_buffer_item("misc",alert);
}
}
else if(parsed[0]=="playermenu")
{
string m=s.replace("playermenu|","",true);
playerstuff=string_split(m,"\r\n",true);
}
else if(parsed[0]=="isadmin")
{
admin=true;
}
else if(parsed[0]=="speak")
{
string temp = s;
temp.replace_this("speak|","");
speak (temp);
}
else if(parsed[0]=="clip")
{
clipboard_copy_text(string_trim_left(s,5));
}
else if(parsed[0]=="vespawning")
{
pause_all_sources();
inve=true;
if(parsed.length () ==2) vetype=parsed[1];
}
else if(parsed[0]=="vesiren"&&parsed.length () >1)
{
if(vesiren.playing) vesiren.stop();
if(parsed[1]!="off")
{
vesiren.load(parsed[1]);
vesiren.play_looped();
}
}
else if(parsed[0]=="vestart" and parsed.length () >2)
{
vesound.load(parsed[1]);
vesound.pitch=stn(parsed[2]);
vesound.play_looped();
}
else if(parsed[0]=="vepitch"&&parsed.length () >1)
{
vesound.pitch=stn(parsed[1]);
}
else if(parsed[0]=="vestop")
{
vesound.stop();
}
else if(parsed[0]=="beacon_switch")
{
beacon=beacon==0?beacon=1:beacon=0;
speak("beacon "+(beacon==0?"disabled":"enabled"));
}
else if(parsed[0]=="veunspawn")
{
if(vetype!="") vetype="";
resume_all_sources();
inve=false;
}
else if(parsed[0]=="lowfuel")
{
velfsound.load("vehicle_lowfuel.ogg");
velfsound.play_looped();
}
else if(parsed[0]=="goodfuel")
{
velfsound.stop();
}
else if(parsed[0]=="notify")
{
string msg;
msg=string_replace(s,"notify|","",false);
tp.play_stationary("notify.ogg",false);
add_buffer_item("misc",msg);
}
else if(parsed[0]=="play_s")
{
tp.play_stationary(parsed[1],false);
}
else if(parsed[0]=="update_objs"&&parsed.length()>=2)
{
string text = s;
s = s.replace("update_objs|","",false);
string[] olines = text.split("\r\n");
if(olines.length()==0) continue;
for(uint i = 0; i < olines.length(); i++)
{
if(olines[i].is_empty()) continue;
string[] oparsed = olines[i].split("|");
update_obj(oparsed[0],parse_double(oparsed[1]),parse_double(oparsed[2]),parse_double(oparsed[3]),oparsed[4]);
}
}
else if(parsed[0]=="pong" and pinging==true)
{
pingpongtimer.pause();
int ms=pingpongtimer.elapsed;
pinging=false;
tp.play_stationary("pingstop.ogg",false);
string spk;
spk="The ping took ";
if(ms<1000) //1second.
spk+=ms+" ms";
else
spk+=ms+" ms, "+ms_to_readable_time(ms);
speak (spk);
}
else if(parsed[0]=="update_position"&&parsed.length()>=6)
{
update_player(parse_double(parsed[1]),parse_double(parsed[2]),parse_double(parsed[3]),parsed[4],parsed[5]);
}
else if(parsed[0]=="hardland")
{
int x=stn(parsed[2]);
int y=stn(parsed[3]);
int z=stn(parsed[4]);
string map=parsed[5];
if(map==mapname and inve==false)
{
tp.play_3d(get_tile_at(x, y, z)+"hardland.ogg", me.x, me.y, me.z, x, y, z, calculate_theta(facing), false);
}
}
else if(parsed[0]=="sitstart")
{
sitting=1;
}
else if(parsed[0]=="sitstop")
{
sitting=0;
}
else if(parsed[0]=="online")
{
int x=stn(parsed[1]);
int y=stn(parsed[2]);
int z=stn(parsed[3]);
string n=parsed[4];
string mp=parsed[5];
spawn_player(x,y,z,mp,n,parse_double(parsed[6]));
int hid = parse_double(parsed[7]);
int index = get_player_index_from(n);
if(index>-1) players[index].hidden=hid;
if(speakonlinemsgs==1 and name!=n and players[index].hidden==0)
{
tp.play_stationary("online.ogg",false);
add_buffer_item("misc",parsed[4]+" came online");
}
}
else if(parsed[0]=="mapname")
{
mapname=string_replace(s,"mapname|","",false);
msound_map_update ();
siren_map_update();
}
else if(parsed[0]=="m_data")
{
load_map(string_replace(s, "m_data ", "", true));
}
else if(parsed[0]=="move" and parsed.length()>=3)
{
me.x=stn(parsed[1]);
me.y=stn(parsed[2]);
me.z=stn(parsed[3]);
p.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
sourcepool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
mpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
distpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
}
else if(parsed[0]=="distsound" and parsed.length()>5)
{
string soundname=parsed[1];
int x=stn(parsed[2]);
int y=stn(parsed[3]);
int z=stn(parsed[4]);
string soundmap=parsed[5];
if(soundmap==mapname)
distpool.play_3d(soundname+".ogg", me.x, me.y, me.z, x, y, z, facing, false);
 else if(soundmap==shmap&&inshelter==true)
shdistpool.play_3d(soundname+".ogg", sh.x, sh.y, sh.z, x, y, z, facing, false);
}
else if(parsed[0]=="buildtile")
build_mode = 1;
else if(parsed[0]=="buildsrc")
build_mode = 2;
else if(parsed[0]=="buildamb")
build_mode = 3;
else if(parsed[0]=="buildzone")
build_mode = 4;
else if(parsed[0]=="buildtpoint")
build_mode = 5;
else if(parsed[0]=="server_quit")
{
in_game1 = false;
}
else if(parsed[0]=="launchmenu" && parsed.length () >= 3)
{
string i=string_replace(parsed[1],"[SPCE]"," ",true);
string t=string_replace(parsed[2], "[]", " ", true);
string items=string_replace(s,parsed[0]+"|"+parsed[1]+"|"+parsed[2]+"|","",true);
sm.i = i;
sm.t = t;
sm.items = items;
}
else if(parsed[0]=="dlg")
{
string alert=s.replace("dlg|","",false);
dlg_message=alert;
dlg_mode=1;
}
else if(parsed[0]=="input")
{
is_serverbox = s;
}
else if(parsed[0]=="entershelter"&&parsed.length () >=5)
{
sh.x=stn(parsed[1]);
sh.y=stn(parsed[2]);
sh.z=stn(parsed[3]);
shmap=parsed[4];
inshelter=true;
}
else if(parsed[0]=="hardban")
{
hardban();
hbanned=1;
data_save();
exit();
}
else if(parsed[0]=="killclient")
{
in_game1 = false;
data_save();
exit();
}
else if(parsed[0]=="exitshelter")
{
sh.x=0;sh.y=0;sh.z=0;shmap="";
inshelter=false;
}
else if(parsed[0]=="death")
{
dead=true;
pause_all_sources();
frozen=true;
deathtimer.restart();
}
else if(parsed[0]=="playerdeath")
{
string msg=string_replace(s,"playerdeath|","",true);
add_buffer_item("kills",msg);
}
else if(parsed[0]=="stopmoving")
{
can_move=false;
if(!SCRIPT_COMPILED&&file_exists("nostun.txt")) can_move=true;
}
else if(parsed[0]=="startmoving")
{
can_move=true;
}
else if(parsed[0]=="freezestart")
{
can_move=false;
frozen=true;
pause_all_sources();
}
else if(parsed[0]=="freezestop")
{
can_move=true;
frozen=false;
resume_all_sources();
}
else if(parsed[0]=="followstart")
{
can_move=false;
following=true;
}
else if(parsed[0]=="followstop")
{
can_move=true;
following=false;
}
else if(parsed[0]=="lowhealth" and parsed.length()>1)
{
lowhealth=true;
currenthealth=stn(parsed[1]);
}
else if(parsed[0]=="goodhealth")
{
lowhealth=false;
}
else
{
speak (s);
}
}
else if(e.channel==1 and readmessages==1)
{
s=get_event_message(e.message);
if(s=="")
{
t_net_loop_mutex.unlock();
continue;
}
string[] parsed=s.split("|");
if(parsed.length()>1)
{
string action=parsed[0];
tp.play_stationary(action+".ogg",false);
string mess=string_trim_left(s,string_len(action)+1);
add_buffer_item("chats",mess);
}
}
else if(e.channel==2)
{
add_buffer_item("misc",get_event_message(e.message));
}
else if(e.channel==3)
{
s = get_event_message(e.message);
if (s=="")
{
t_net_loop_mutex.unlock();
continue;
}
string[] parsed=s.split("|");
if(parsed.length()>=5 and is_sound_number(parsed[1]) and is_sound_number(parsed[2]) and is_sound_number(parsed[3]))
{
if(is_sound_exists(parsed[0]+".ogg") and parsed.length()==5)
{
if(parsed[4]==mapname&&inve==false&&frozen==false)
tp.play_3d(parsed[0]+".ogg", me.x, me.y, me.z, stn(parsed[1]), stn(parsed[2]), stn(parsed[3]), calculate_theta(facing), false);
}
}
}
else if(e.channel==4)
{
s = get_event_message(e.message);
if (s=="") 
{
t_net_loop_mutex.unlock();
continue;
}
string[] parsed=s.split("|");
if(parsed[0]=="createmsound"&&parsed.length()>=8) createmsound(parsed[1],parsed[2],stn(parsed[3]),stn(parsed[4]),stn(parsed[5]),parsed[6],stn(parsed[7]));
else if(parsed[0]=="updatemsound"&&parsed.length()>=6) updatemsound(parsed[1],stn(parsed[2]),stn(parsed[3]),stn(parsed[4]),stn(parsed[5]));
else if(parsed[0]=="destroymsound"&&parsed.length()>1) destroymsound(parsed[1]);
else if(parsed[0]=="createsiren"&&parsed.length()>=7) createsiren(parsed[1],parsed[2],stn(parsed[3]),stn(parsed[4]),stn(parsed[5]),parsed[6]);
else if(parsed[0]=="updatesiren"&&parsed.length()>=5) updatesiren(parsed[1],stn(parsed[2]),stn(parsed[3]),stn(parsed[4]));
else if(parsed[0]=="destroysiren"&&parsed.length()>1) destroysiren(parsed[1]);
}
}
t_net_loop_mutex.unlock();
}
return (0);
}