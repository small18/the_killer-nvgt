void data_save ()
{
json_object js;
js.set ("menumusvol",menumusvol);
js.set ("menu_sidescrolling",sidescrolling);
js.set ("menu_musictrack",musictrack);
js.set ("3d_audio_system",global_hrtf);
js.set ("audio_refresh_rate",audio_refresh_rate);
js.set ("user_name",name);
js.set ("user_password",pass);
js.set ("user_mail",mail);
js.set ("currently_input_device",currently_input_device);
js.set ("currently_output_device",currently_output_device);
js.set ("speakonlinemsgs",speakonlinemsgs);
js.set ("importbufferlogs",importbufferlogs);
js.set ("rcontrol",rcontrol);
js.set ("tts_default_voice",tts.voice);
js.set ("tts_default_rate",tts.rate);
js.set ("tts_default_volume",tts.volume);
js.set ("use_screen_reader",use_sr);
js.set("speak_interrupt",tts_default_interrupt);
js.set("fi",join(fi,"\r\n"));
js.set("hbanned",hbanned);
js.set("currently_output_device_name",currently_output_device_name);
//在这之前添加要添加的东西
if (directory_exists(DIRECTORY_APPDATA+"TheKiller")==false)
{
directory_create(DIRECTORY_APPDATA+"TheKiller");
}
file f;
f.open (DIRECTORY_APPDATA+"TheKiller\\config.dat","wb");
f.write (string_aes_encrypt(js.stringify(),"ie,Acjtf^m;nj@6I02?(4D,F=&4JOm}74>mI9titQ`^;_vYT`:KaP8Ms~-qt)Rd@WhYbR/[<^9(r*B;W(!["));
f.close ();
}
void data_read ()
{
file f;
f.open (DIRECTORY_APPDATA+"TheKiller\\config.dat","rb");
string data = string_aes_decrypt(f.read(),"ie,Acjtf^m;nj@6I02?(4D,F=&4JOm}74>mI9titQ`^;_vYT`:KaP8Ms~-qt)Rd@WhYbR/[<^9(r*B;W(![");
f.close ();
if (data=="")
{
return;
}

json_object@ js = parse_json(data);
try
{
//在这之后添加要读入的东西
menumusvol = js["menumusvol"];
sidescrolling=js["menu_sidescrolling"];
musictrack = js["menu_musictrack"];
global_hrtf = js["3d_audio_system"];
if(js.exists("audio_refresh_rate")) audio_refresh_rate = js["audio_refresh_rate"];
name = js["user_name"];
pass = js["user_password"];
mail = js["user_mail"];
currently_input_device = js["currently_input_device"];
currently_output_device = js["currently_output_device"];
speakonlinemsgs = js["speakonlinemsgs"];
importbufferlogs = js["importbufferlogs"];
rcontrol = js["rcontrol"];
tts.set_voice(js["tts_default_voice"]);
tts.set_rate(js["tts_default_rate"]);
tts.set_volume(js["tts_default_volume"]);
use_sr = js["use_screen_reader"];
tts_default_interrupt = js["speak_interrupt"];
string fi_string = js["fi"];
string[] fi_array = fi_string.split("\r\n",false);
for(uint i = 0; i < fi_array.length(); i++)
{
fi[i] = fi_array[i];
}
hbanned = js["hbanned"];
currently_output_device_name = js["currently_output_device_name"];
}
catch 
{

}
}
