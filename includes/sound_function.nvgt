/*Until now, nvgt has not been able to adapt pack_file well, so I am worried about the way to handle sound files in the future, I constructed this function in advance to prevent too big changes in the future.
function string _get_sounds_(string sound_name)
by tom.
*/
string _get_sounds_(string sound_name)
{
return sound_name;
//return "sounds/"+sound_name;
}
int get_audio_refresh_interval()
{
if(audio_refresh_rate==30) return 33;
if(audio_refresh_rate==60) return 16;
if(audio_refresh_rate==90) return 11;
if(audio_refresh_rate==120) return 8;
audio_refresh_rate=60;
return 16;
}
void pos()
{
mr.x=round(me.x,0);
mr.y=round(me.y,0);
if(audio_listener_update_timer.elapsed<get_audio_refresh_interval()) return;
audio_listener_update_timer.restart();
tp.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
p.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
sourcepool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
mpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
distpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
objpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
}

int play_3d(sound_pool handle,string filename, float listener_x, float listener_y, float listener_z, float sound_x, float sound_y, float sound_z, double rotation, bool looping, bool persistent = false , int volume = 0.0) {
	return handle.play_extended(3, filename,sound_default_pack , listener_x, listener_y, listener_z, sound_x, sound_y, sound_z, rotation, 0, 0, 0, 0, 0, 0, looping, 0, 0.0, volume, 100.0, persistent);
}
