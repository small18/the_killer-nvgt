funcdef int menu_callback(dynamic_menu_pro@, string);
dynamic_menu_pro@ active_dynamic_menu=null;

void dynamic_menu_callback_bridge(menu@ source, string data)
{
	if (@active_dynamic_menu==null or @active_dynamic_menu.callback_handle==null) {return;}
	int result=active_dynamic_menu.callback_handle(active_dynamic_menu,data);
	if (result>0) {active_dynamic_menu.forced_result=result;}
} // func.dynamic_menu_callback_bridge.

void fade_menu_sound(sound@ handle, double final_volume=-100, double delay=25)
{
	if (@handle==null or !handle.active) {return;}
	while (handle.volume!=final_volume) {
		if (handle.volume>final_volume) {handle.volume-=1;}
		else if (handle.volume<final_volume) {handle.volume+=1;}
		wait(delay);
	} // while.volume.
	handle.close();
} // func.fade_menu_sound.

void fade(sound@ handle, double final_volume=-100, double delay=25)
{
	fade_menu_sound(handle,final_volume,delay);
} // func.fade.

class dynamic_menu_item
{
	string option;
	string name;
	bool activate;
} // class.dynamic_menu_item.

class dynamic_menu_pro
{
	menu inner;
	dynamic_menu_item[] item_list;
	menu_callback@ callback_handle=null;
	string callback_data;
	string open_sound,click_sound,edge_sound,wrap_sound,enter_sound;
	bool wrap,enable_first_letter_navigation,enable_side_scrolling,enable_left_and_right,enable_up_and_down,enable_home_and_end,letters_autoactivate;
	bool running=false;
	bool running_side_menu=false;
	int forced_result=0;
	sound music;
	audio_form side_form;
	int side_list=-1;
	int side_ok=-1;
	int side_cancel=-1;
	int side_position=0;
	bool side_left_held=false;
	bool side_right_held=false;
	int side_left_repeat=500;
	int side_right_repeat=500;
	timer side_left_timer;
	timer side_right_timer;

	bool reset(bool completely)
	{
		inner.reset(true);
		side_form.reset();
		item_list.resize(0);
		@callback_handle=null;
		callback_data="";
		forced_result=0;
		running=false;
		running_side_menu=false;
		side_position=0;
		side_left_held=false;
		side_right_held=false;
		side_left_repeat=500;
		side_right_repeat=500;
		side_left_timer.restart();
		side_right_timer.restart();
		if (completely) {
			open_sound=""; click_sound=""; edge_sound=""; wrap_sound=""; enter_sound="";
			wrap=true; enable_first_letter_navigation=true; enable_side_scrolling=false;
			enable_left_and_right=false; enable_up_and_down=true; enable_home_and_end=true;
			letters_autoactivate=false;
		} // if.completely.
		return(true);
	} // method.reset.

	int add_item_tts(string text, string name="", bool act=true)
	{
		dynamic_menu_item item;
		item.option=text;
		item.name=name;
		item.activate=act;
		item_list.insert_last(item);
		return(item_list.length());
	} // method.add_item_tts.

	int add_item(string filename, string name="", string key="", bool act=true)
	{
		return(add_item_tts(filename,name,act));
	} // method.add_item.

	int add_item_tts_key(string text, string name="", string key="", bool act=true)
	{
		return(add_item_tts(text,name,act));
	} // method.add_item_tts_key.

	bool set_callback(menu_callback@ callback, string user_data)
	{
		@callback_handle=callback;
		callback_data=user_data;
		return(true);
	} // method.set_callback.

	int get_item_count()
	{
		return(item_list.length());
	} // method.get_item_count.

	int get_position()
	{
		if (!running) {return(-1);}
		if (running_side_menu) {return(side_position+1);}
		return(inner.focused_item+1);
	} // method.get_position.

	string get_item_name(int item)
	{
		if (item<1 or item>item_list.length()) {return("");}
		return(item_list[item-1].name);
	} // method.get_item_name.

	void add_music(string musicpath)
	{
		if (musicpath=="") {return;}
		if (!music.playing and music.load(musicpath)) {music.play_looped();}
	} // method.add_music.

	void fade_music(int value1)
	{
		fade_menu_sound(music,-100,value1);
		music.stop();
	} // method.fade_music.

	void stop_music()
	{
		music.stop();
	} // method.stop_music.

	int run(string intro, bool is_intro_tts)
	{
		return(run_extended(intro,is_intro_tts,0,false));
	} // method.run.

	int run_extended(string intro, bool is_intro_tts, int start_position, bool auto_speak_first)
	{
		if (enable_side_scrolling) {return(run_side_extended(intro,is_intro_tts,start_position,auto_speak_first));}
		inner.reset(true);
		inner.open_sound=open_sound;
		inner.click_sound=click_sound;
		inner.edge_sound=edge_sound;
		inner.wrap_sound=wrap_sound;
		inner.select_sound=enter_sound;
		inner.wrap=wrap;
		inner.first_letter_navigation=enable_first_letter_navigation;
		inner.focus_first_item=true;
		inner.intro_text=intro;
		@active_dynamic_menu=this;
		@inner.background_callback=dynamic_menu_callback_bridge;
		inner.background_callback_data=callback_data;
		for (uint i=0; i<item_list.length(); i++) {inner.add_item(item_list[i].option,item_list[i].name);}
		if (start_position>0) {inner.focused_item=start_position-1;}
		forced_result=0;
		running=true;
		while (inner.monitor()) {
			if (forced_result>0) {
				running=false;
				@active_dynamic_menu=null;
				return(forced_result);
			} // if.forced.
			wait(5);
		} // while.monitor.
		running=false;
		@active_dynamic_menu=null;
		if (forced_result>0) {return(forced_result);}
		if (inner.selected_item<0) {return(0);}
		return(inner.selected_item+1);
	} // method.run_extended.

	private double get_side_sound_pan()
	{
		int count=get_item_count();
		if (count<=0) {return(0);}
		return(((side_position+1)*100.0/count)-50.0);
	} // method.get_side_sound_pan.

	private bool play_side_sound(string soundpath, bool positioned)
	{
		if (soundpath=="") {return(false);}
		sound@ handle=sound_play(soundpath);
		if (@handle==null) {return(false);}
		if (positioned) {handle.pan=get_side_sound_pan();}
		return(true);
	} // method.play_side_sound.

	private bool move_side_cursor(int direction)
	{
		int count=get_item_count();
		if (count<=0) {return(false);}
		side_position=side_form.get_list_position(side_list);
		if (side_position<0) {side_position=0;}
		int target=side_position+direction;
		if (target<0 or target>=count) {
			if (!wrap) {
				play_side_sound(edge_sound,true);
				return(true);
			} // if.no_wrap.
			target=(direction>0)? 0 : count-1;
			play_side_sound(wrap_sound,false);
			stop_speech();
			wait(10);
		} // if.boundary.
		side_position=target;
		side_form.set_list_position(side_list,side_position,true);
		play_side_sound(click_sound,true);
		return(true);
	} // method.move_side_cursor.

	private int on_side_form_list_event(audio_form@ f, int c, control_event_type event, dictionary@ args)
	{
		if (event!=event_list_cursor) {return(0);}
		side_position=f.get_list_position(side_list);
		if (args.exists("boundary")) {
			if (!wrap) {
				play_side_sound(edge_sound,true);
				return(0);
			} // if.no_wrap.
			int key=int(args["key"]);
			int pos=(key==KEY_DOWN or key==KEY_RIGHT)? 0 : f.get_list_count(side_list)-1;
			side_position=pos;
			play_side_sound(wrap_sound,false);
			stop_speech();
			wait(10);
			f.set_list_position(side_list,pos,true);
			play_side_sound(click_sound,true);
			return(1);
		} // if.boundary.
		play_side_sound(click_sound,true);
		return(0);
	} // method.on_side_form_list_event.

	private int run_side_extended(string intro, bool is_intro_tts, int start_position, bool auto_speak_first)
	{
		side_form.reset();
		side_form.create_window();
		side_list=side_form.create_list("Menu", repeat_boundary_items : true);
		side_form.set_event_callback(side_list,on_control_event_callback(on_side_form_list_event));
		side_ok=side_form.create_button("OK",true);
		side_form.set_state(side_ok,true,false);
		side_cancel=side_form.create_button("Cancel",false,true);
		side_form.set_state(side_cancel,true,false);
		side_form.focus_silently(side_list);
		side_form.set_list_multinavigation(side_list,enable_first_letter_navigation,false);
		for (uint i=0; i<item_list.length(); i++) {
			side_form.add_list_item(side_list,item_list[i].option,item_list[i].name,-1,false,false);
		} // for.items.
		if (item_list.length()==0) {return(0);}
		side_position=0;
		if (start_position>0 and start_position<=item_list.length()) {side_position=start_position-1;}
		side_form.set_list_position(side_list,side_position,false);
		forced_result=0;
		running=true;
		running_side_menu=true;
		play_side_sound(open_sound,false);
		if (intro!="") {speak(intro,true);}
		side_form.set_list_position(side_list,side_position,true);
		while (true) {
			if (@callback_handle!=null) {
				int result=callback_handle(this,callback_data);
				if (result>0) {forced_result=result;}
			} // if.callback.
			if (forced_result>0) {
				running=false;
				running_side_menu=false;
				return(forced_result);
			} // if.forced.
			side_form.monitor();
			side_position=side_form.get_list_position(side_list);
			if (!key_down(KEY_LEFT)) {
				side_left_held=false;
				side_left_repeat=500;
				side_left_timer.restart();
			} // if.left_up.
			else if (enable_left_and_right) {
				if (!side_left_held) {
					side_left_held=true;
					side_left_repeat=500;
					side_left_timer.restart();
					move_side_cursor(-1);
					continue;
				} // if.left_first.
				else if (side_left_timer.elapsed>=side_left_repeat) {
					side_left_repeat=50;
					side_left_timer.restart();
					move_side_cursor(-1);
					continue;
				} // if.left_repeat.
			} // if.left_down.
			if (!key_down(KEY_RIGHT)) {
				side_right_held=false;
				side_right_repeat=500;
				side_right_timer.restart();
			} // if.right_up.
			else if (enable_left_and_right) {
				if (!side_right_held) {
					side_right_held=true;
					side_right_repeat=500;
					side_right_timer.restart();
					move_side_cursor(1);
					continue;
				} // if.right_first.
				else if (side_right_timer.elapsed>=side_right_repeat) {
					side_right_repeat=50;
					side_right_timer.restart();
					move_side_cursor(1);
					continue;
				} // if.right_repeat.
			} // if.right_down.
			if (side_form.is_pressed(side_cancel)) {
				running=false;
				running_side_menu=false;
				return(0);
			} // if.cancel.
			if (side_form.is_pressed(side_ok)) {
				if (side_position<0 or side_position>=item_list.length()) {continue;}
				play_side_sound(enter_sound,true);
				if (!item_list[side_position].activate) {continue;}
				running=false;
				running_side_menu=false;
				return(side_position+1);
			} // if.ok.
			wait(5);
		} // while.running.
		return(0);
	} // method.run_side_extended.
} // class.dynamic_menu_pro.

dynamic_menu_pro m;
void mainmenu()
{
setupmenu(true,true);
m.add_item_tts("Connection menu","connectionmenu");
m.add_item_tts("game settings","game settings");
m.add_item_tts("test speaker","speaker test");
m.add_item_tts("Click here to visit our GitHub repository.","urlo");
m.add_item_tts("exit","exit");
int r=m.run("Main menu",true);
if (m.get_item_name(r)=="connectionmenu")
{
m.fade_music(0);
connectionmenu();
}
else if (m.get_item_name(r)=="game settings")
{
m.fade_music(10);
game_settings();
}
else if (m.get_item_name(r)=="speaker test")
{
m.fade_music(10);
speak ("Test speaker");
dlg_audio (_get_sounds_("speaker_test.ogg"));
mainmenu();
}
else if (m.get_item_name(r)=="urlo")
{
m.fade_music(10);
urlopen ("https://github.com/small18/the_killer-nvgt");
mainmenu();
}
else
{
m.fade_music(5);
data_save();
exit();
}
}
void connectionmenu()
{
setupmenu(false,true);
if (name!="" and pass!="")
{
m.add_item_tts("sign in "+name,"play");
}
m.add_item_tts("sign in  as","sign in  as");
m.add_item_tts("new account","create a new account");
m.add_item_tts("go back","go back");
int r=m.run("Select an option",true);
if (m.get_item_name(r)=="create a new account")
{
m.fade_music(10);
registering_account();
}
else if(m.get_item_name(r)=="sign in  as")
{
setup_account();
}
else if (m.get_item_name(r)=="go back")
{
wait(150);
mainmenu();
}
else if(m.get_item_name(r)=="play")
{
login();
}
else
{
wait(150);
mainmenu();
}
}
int yesno(string question)
{
setupmenu(false,true);
m.add_item_tts(question,"question",false);
m.add_item_tts("Yes","yes");
m.add_item_tts("no","no");
int mres=m.run(question,true);
if (m.get_item_name(mres)=="yes")
return 1;
else
return 2;
}
aabb trackaabb;
void checkarroundmenu()
{
setupmenu();
m.add_item_tts("Stop tracking","stoptrack");
for(uint i=0; i<zones.length(); i++)
{
string[] parsed=string_split(zones[i],":",false);
if(parsed.length()>7)
{
m.add_item_tts(parsed[6]+" at "+parsed[0]+", "+parsed[2]+", "+parsed[4],parsed[6]);
}
}
int mres=m.run("Find what?",true);
if(m.get_item_name(mres)=="" or m.get_item_name(mres)=="stoptrack" or mres==0)
{
speak ("Stopped tracking");
trackaabb.set_min(vector(0,0,0));
trackaabb.set_max(vector(0,0,0));
tracking = "";
return;
}
else
{
int z=get_zone_index(m.get_item_name(mres));
if(z>-1)
{
string[] ps=string_split(zones[z],":",true);
trackaabb.set_min(vector(parse_double(ps[0]),parse_double(ps[2]),parse_double(ps[4])));
trackaabb.set_max(vector(parse_double(ps[1]),parse_double(ps[3]),parse_double(ps[5])));
tracking = ps[6];
tell_where(trackaabb,"loctrack");
}
else
{
if(SCRIPT_COMPILED==false) speak ("That zone could not be found");
}
}
}
void setupmenu(bool main=false, bool audo=false)
{
m.reset(true);
if (main==true)
m.add_music(_get_sounds_(musictrack));
m.open_sound=_get_sounds_("menuopen.ogg");
m.enter_sound=_get_sounds_("menuenter.ogg");
m.click_sound=_get_sounds_("menumove.ogg");
m.wrap_sound=_get_sounds_("menuwrap.ogg");
if(audo==true)
m.letters_autoactivate=false;
m.edge_sound=_get_sounds_("menuedge.ogg");
if(sidescrolling==1)
{
m.enable_side_scrolling=true;
}
m.enable_first_letter_navigation=true;
if(sidescrolling==1)
m.enable_left_and_right=true;
else
{
m.enable_up_and_down=true;
m.enable_side_scrolling=false;
}
m.wrap=true;
m.enable_home_and_end=true;
if(!main)
m.set_callback(netclb,"");
} 
string inventorymenu(string item_array)
{
string ret;
string[]inventory_items=string_split(item_array,"\r\n",false);
uint itemcount=0;
m.reset(true);
m.open_sound="invopen.ogg";
m.click_sound="invmove.ogg";
m.enter_sound="";
m.wrap_sound="";
m.enable_first_letter_navigation=true;
m.enable_up_and_down=true;
m.enable_side_scrolling=true;
m.enable_left_and_right=true;
m.enable_home_and_end=true;
m.set_callback(invclb,"");
for(uint i=0; i<inventory_items.length(); i++)
{
string[] i2=string_split(inventory_items[i],"=",false);
itemcount+=1;
m.add_item_tts(i2[0]+", you have "+i2[1],i2[0]);
}
int r=m.run("inventory menu with "+itemcount+" items",true);
send_reliable(0, "invclose", 0);
if(m.get_item_name(r)=="" or r==0) return "";
return m.get_item_name(r);
}
int invclb(dynamic_menu_pro@ im, string data)
{
tk_loop(true);
if(key_pressed(KEY_SPACE))
{
if(shift_is_down()==false&&alt_is_down())
{
send_reliable(0,"giveitem|"+im.get_item_name(im.get_position()),0);
return m.get_position();
}
else if(shift_is_down()&&alt_is_down()==false)
{
send_reliable(0,"auctionitem|"+im.get_item_name(im.get_position()),0);
return m.get_position();
}
else
{
send_reliable(0,"describe|"+im.get_item_name(im.get_position()),0);
}
}
return 0;
}
string invmenu()
{
timer resetcharstimer;
send_reliable(0,"invopen",0);
string content=inv;
if(content=="") {
speak ("no items");
return"";
}
string item1=inventorymenu(content);
return item1;
}
int netclb(dynamic_menu_pro@ m, string data)
{
if(n.connected_peers>0&&connected) tk_loop(true);
copy_translation_text_loop();
return 0;
}
void serverside_menu(string sndtxt, string menu, string menuitems)
{
//setupmenu();
m.reset(true);
m.click_sound="menumove.ogg";
m.enter_sound="menuenter.ogg";
m.enable_first_letter_navigation=true;
m.wrap=true;
m.enable_up_and_down=true;
m.set_callback(netclb,"");
if(menuitems=="")
return;
string[] items=string_split(menuitems,"[]",false);
for(uint i=0; i<items.length(); i++)
{
string[] parsed=string_split(items[i],":",false);
m.add_item_tts(parsed[0],parsed[1]);
}
int mres=m.run(menu,true);
if(m.get_item_name(mres)=="back" or mres==0)
send_reliable(0,sndtxt+"|back",0);
else
{
send_reliable(0,sndtxt+"|"+m.get_item_name(mres),0);
}
}
void store_menu(string storeitems)
{
m.reset(true);
m.enter_sound="store_menuenter.ogg";
m.click_sound="store_move.ogg";
m.edge_sound="menuedge.ogg";
m.enable_first_letter_navigation=true;
m.enable_up_and_down=true;
m.wrap=false;
m.enable_home_and_end=true;
m.set_callback(netclb,"");
string[] items=string_split(storeitems,"\r\n",true);
for (uint i=0; i<items.length(); i++)
{
string[] item=string_split(items[i]," ",true);
string it=string_replace(item[0],".","",true);
m.add_item_tts(items[i],it);
}
int mres=m.run("store menu. There are "+items.length()+" items.",true);
if (mres!=0)
{
string amount=v.input("Amount of "+m.get_item_name(mres)+"?");
send_reliable(0,"purchase|"+m.get_item_name(mres)+"|"+amount,0);
}
}

class servermenu
{
string t;
string i;
string items;
}
void playermenu(string[] users)
{
m.reset(true);
m.open_sound="";
m.enter_sound="";
m.click_sound="";
m.wrap_sound="";
m.enable_first_letter_navigation=true;
m.enable_up_and_down=true;
m.enable_left_and_right=true;
m.enable_home_and_end=true;
m.set_callback(playermenu_callback,"");
if(@tracking_player!=null)
m.add_item_tts("stop tracking "+tracking_player.name,"stop tracking");
for(uint i = 0; i < users.length(); i++)
{
if(@tracking_player!=null&&users[i]==tracking_player.name) continue;
m.add_item_tts(users[i],users[i]);
}
playerstuff.resize(0);
int r = m.run("users menu",true);
if(m.get_item_name(r)==""||r==0)
{
speak("canceled");
}
else if(m.get_item_name(r)=="stop tracking")
{
speak("stop tracking "+tracking_player.name);
@tracking_player=null;
}
else
{
int index = get_player_index_from(m.get_item_name(r));
if(index>-1)
{
speak("tracking "+m.get_item_name(r));
@tracking_player = players[index];
}
else
{
speak("This player is offline");
}
}
}
int playermenu_callback(dynamic_menu_pro@ m, string data)
{
tk_loop(true);
if(m.get_item_name(m.get_position())!="")
{
if(key_pressed(KEY_F1))
{
speak(m.get_item_name(m.get_position())+" copy to clipboard.");
clipboard_set_text(m.get_item_name(m.get_position()));
}
if(key_pressed(KEY_F2))
{
disable_input();
string pm_text = input_box("enter the message that you want to send to "+m.get_item_name(m.get_position()));
if(!pm_text.is_empty())
send_reliable(0,"/pm "+m.get_item_name(m.get_position())+" "+pm_text,1);
enable_input();
}
}
return 0;
}
