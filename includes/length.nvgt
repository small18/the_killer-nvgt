class translation_rule
{
    string src;
    string dst;
    string[] literals;
    int[] placeholders;
    int max_placeholder = -1;
}

dictionary g_exact_translations;
translation_rule[] g_template_translation_rules;
string g_src_text;
string g_trans_text;

int parse_placeholder_number(const string&in text, int start_index, int&out next_index)
{
    int value = 0;
    bool found_digit = false;
    next_index = start_index;

    while (next_index < int(text.length()))
    {
        string digit_char = text.substr(next_index, 1);
        if (!digit_char.is_digits()) break;

        value = value * 10 + stn(digit_char);
        found_digit = true;
        next_index++;
    }

    if (!found_digit) return -1;
    return value;
}

bool has_placeholder(const string&in text)
{
    int i = 0;
    while (i < int(text.length()))
    {
        if (text.substr(i, 1) == "%" && i + 1 < int(text.length()))
        {
            string next_char = text.substr(i + 1, 1);
            if (next_char.is_digits()) return true;
        }
        i++;
    }

    return false;
}

void parse_source_template(const string&in src, string[]&out literals, int[]&out placeholders)
{
    literals.resize(0);
    placeholders.resize(0);

    string current_literal = "";
    int i = 0;

    while (i < int(src.length()))
    {
        if (src.substr(i, 1) == "%" && i + 1 < int(src.length()))
        {
            int next_index = i + 1;
            int placeholder = parse_placeholder_number(src, next_index, next_index);
            if (placeholder >= 0)
            {
                literals.insert_last(current_literal);
                current_literal = "";
                placeholders.insert_last(placeholder);
                i = next_index;
                continue;
            }
        }

        current_literal += src.substr(i, 1);
        i++;
    }

    literals.insert_last(current_literal);
}

bool build_rule_from_line(const string&in raw_line, translation_rule&out rule)
{
    string line = raw_line.trim_whitespace();
    if (line.length() == 0) return false;

    int separator = line.find("[=]");
    int separator_length = 3;
    if (separator < 0)
    {
        separator = line.find("=");
        separator_length = 1;
    }
    if (separator < 0) return false;

    string src = line.substr(0, separator).trim_whitespace();
    if (src.length() == 0) return false;

    rule.src = src;
    rule.dst = line.substr(separator + separator_length).trim_whitespace();
    parse_source_template(rule.src, rule.literals, rule.placeholders);

    rule.max_placeholder = -1;
    for (int i = 0; i < int(rule.placeholders.length()); i++)
    {
        if (rule.placeholders[i] > rule.max_placeholder) rule.max_placeholder = rule.placeholders[i];
    }

    return true;
}

bool match_rule_and_capture(const string&in text, const translation_rule&in rule, string[]&out args)
{
    args.resize(rule.max_placeholder + 1);
    for (int i = 0; i < int(args.length()); i++) args[i] = "";

    string first_literal = rule.literals[0];
    if (!text.starts_with(first_literal)) return false;

    int text_length = int(text.length());
    int pos = int(first_literal.length());

    for (int i = 0; i < int(rule.placeholders.length()); i++)
    {
        string next_literal = rule.literals[i + 1];
        int found = next_literal.length() == 0 ? text_length : text.find(next_literal, pos);
        if (found < 0) return false;

        args[rule.placeholders[i]] = text.substr(pos, found - pos);
        pos = found + int(next_literal.length());
    }

    return pos == text_length;
}

void add_translation_rule(const translation_rule&in rule)
{
    if (rule.max_placeholder < 0)
    {
        g_exact_translations.set(rule.src, rule.dst);
        return;
    }

    g_template_translation_rules.insert_last(rule);
}

void speak_length_start()
{
    g_exact_translations.delete_all();
    g_template_translation_rules.resize(0);

    file f;
    if (!f.open("dictionary.txt", "rb")) return;

    string content = f.read();
    f.close();

    string[] lines = split_text(content, "\r\n", "\n");
    for (int i = 0; i < int(lines.length()); i++)
    {
        translation_rule rule;
        if (build_rule_from_line(lines[i], rule)) add_translation_rule(rule);
    }
}

string speak_length(string text)
{
    string exact;
    if (g_exact_translations.get(text, exact)) return exact;

    if (!has_placeholder(text))
    {
        for (int i = int(g_template_translation_rules.length()) - 1; i >= 0; i--)
        {
            string[] args;
            if (match_rule_and_capture(text, g_template_translation_rules[i], args))
            {
                return g_template_translation_rules[i].dst.format(args);
            }
        }
    }

    return text;
}

string translation_callback(const string&in text)
{
    g_src_text = text;
    g_trans_text = speak_length(g_src_text);
    return g_trans_text;
}

void copy_translation_text_loop()
{
    if (key_pressed(KEY_F12))
    {
        if (key_down(KEY_LALT) || key_down(KEY_RALT))
        {
            clipboard_set_text(g_src_text);
            speak("copy");
        }
        else
        {
            clipboard_set_text(g_trans_text);
            speak("copy");
        }
    }
}
