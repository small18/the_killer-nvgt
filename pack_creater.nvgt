//#include "speech.nvgt"
#pragma console
bool encrypt = false;
string key , foldername , filename;
string[] file_list;
pack_file sounds;
sound@ progress_sound;
tone_synth progress_synth;
timer t;
bool in_cmd;
void main()
{
string[] cmd = COMMAND_LINE.split(" ");
if(cmd.length()>0&&cmd[0]=="use_file")
{
in_cmd=true;
if(!file_exists("packc.pdata"))
{
print("Packc.pdata file does not exist\r\n");
exit(1);
}
}
if(!in_cmd)
{
int pd=question("pack creator","would you like to use last saved settings?");
if(pd!=1)
{
foldername = input_box("pack_creater","Enter folder name");
if(foldername.is_empty())
{
exit();
}
filename = input_box("pack_creater","Enter file name");
if(filename.is_empty())
{
exit();
}
int answer=question("pack creater", "would you like these files to be encrypted");
if (answer==1)
{
encrypt = true;
key = input_box("pack_creater","Enter encryption key");
if(key.is_empty())
{
exit();
}
}
}
}
else
{
file f;
f.open("packc.pdata","rb");
string[] parsed=f.read().split(";",false);
f.close();
if(parsed.length()==2) parsed.insert_last("");
if(parsed.length()==3) parsed.insert_last("");
filename=parsed[0];
foldername=parsed[1];
int e=parse_double(parsed[2].trim_whitespace_left());
if(e==1) encrypt=true;
key=parsed[3];
}
get_in_total();
if(in_cmd)
print(file_list.length()+" files will be packaged.\r\n");
else
alert("pack_creater",file_list.length()+" files will be packaged, press enter to continue.");
creater();
}
void get_in_total(string path="")
{
string[] directories = find_directories(foldername+"/"+(path!=""?path+"/":"")+"*");
string[] files = find_files(foldername+"/"+(path!=""?path+"/":"")+"*");
if(directories.length()>0)
{
for(uint i = 0; i < directories.length(); i++)
{
get_in_total(path+"/"+directories[i]);
}
}
for(uint i =0; i < files.length(); i++)
{
file_list.insert_last((path == ""?files[i]:path+"/"+files[i]));
}
}
void creater()
{
string key1 = key;
int percent = -1;
sounds.create(filename,key);
if(in_cmd)
print("working\r\n");
else
show_window("working");
t.restart();
for(uint i = 0; i < file_list.length(); i++)
{
double l=file_list.length(), ind = i;
int perc = ind/l*100.0;
if(percent!=perc)
{
percent = perc;
if(in_cmd)
print(percent+"%, "+i+"/"+l+".\r\n");
else
beep_progress(percent);
}
sounds.add_file(foldername+"/"+file_list[i],file_list[i]);
}
sounds.close();
destroy_window();
t.pause();
if(in_cmd)
print("success!"+file_list.length()+" files have been packaged into "+filename+",time:"+t.elapsed+"MS.\r\n");
else
alert("pack_creater","success!"+file_list.length()+" files have been packaged into "+filename+",time:"+t.elapsed+"MS.");
write_key();
exit();
}
void write_key()
{
file f;
f.open("packc.pdata","wb");
f.write(filename+";"+foldername+";"+(encrypt?1:0)+";"+key);
f.close();
}
void beep_progress(double value)
{
value = round(value,0);
int sound_pan = value-50;
if(value<0) value = 0;
if(value>100) value = 100;
int freq = 110*2**(value/25);
progress_synth.waveform_type=4;
progress_synth.freq_ms(freq,40);
progress_synth.set_edge_fades(1,1);
@progress_sound = progress_synth.write_wave_sound();
progress_synth.reset();
progress_sound.pan = sound_pan;
progress_sound.play();
}