class playerweapon
{
player@p;
int max_ammo;
playerweapon(player@pl)
{
@p=pl;
}
int get_reloadtime()
{
var@ reload_t = get_wdata_value(p.weapon,"reload_time");
if(@reload_t==null) return -1;
return reload_t;
}
int get_max_ammo()
{
var@ mammo = get_wdata_value(p.weapon,"max_ammo");
if(@mammo==null) return 0;
return mammo;
}
json_object@ get_properties()
{
json_object j;
int index = get_wdata_index(p.weapon);
if(index>-1)
{
if(wdata[index].data.exists("walk_time")) j.set("walk_time",get_wdata_value(p.weapon,"walk_time"));
if(wdata[index].data.exists("can_jump")) j.set("can_jump",get_wdata_value(p.weapon,"can_jump"));
j.set("fire_mode",get_wdata_value(p.weapon,"fire_mode"));
j.set("fire_time",get_wdata_value(p.weapon,"fire_time"));
p.firetime = get_wdata_value(p.weapon,"fire_time");
}
return j;
}
void reload()
{
int amount;
if(p.get_item_count("ammo_"+p.weapon)<get_max_ammo()) amount=p.get_item_count("ammo_"+p.weapon);
else amount=get_max_ammo();
if(p.get_ammo_count(p.weapon)<amount)
{
int ammot=amount-p.get_ammo_count(p.weapon);
p.give("ammo_"+p.weapon,-ammot);
p.ammo_give(p.weapon,ammot);
}
}
}
