const string key = "jslkdjvoigvrvklsdfnkjfsklsdjlfkawejioejgiksrdfnhkjzskldjfklejgkivjkgjtjtestestejkij";
void scd(int ie)
{
string charfolder="chars/"+players[ie].name;
/*
for(uint i=0; i<guns.length(); i++)
{
int a=players[ie].get_ammo_count_from(guns[i]);
if(a>0)
{
players[ie].give("ammo_"+guns[i],a);
}
}
players[ie].ammo.delete_all();
*/
players [ie].data["achievements"]=players[ie].a.achieve;
players [ie].data["storestage"]=players[ie].storestage;
players [ie].data["storetimer"]=players[ie].storetimer.elapsed;
players [ie].data["dfc"]=players[ie].deathfreecards;
players [ie].data["vs"]=players[ie].aircraftfuel+"\r\n"+players[ie].aircrafthealth+"\r\n"+players[ie].tankfuel+"\r\n"+players[ie].tankhealth+"\r\n"+players[ie].pcfuel+"\r\n"+players[ie].pchealth;
players [ie].data["x"]=round(players[ie].x,0);
players [ie].data["y"]=round(players[ie].y,0);
players [ie].data["facing"]=players[ie].facing;
players [ie].data["z"]=round(players[ie].z,0);
//if(players[ie].is_paid())
players [ie].data["paid"]=players[ie].paid;
players [ie].data["compid"]=players[ie].compid;
players [ie].data["air"]=players[ie].air;
players [ie].data["food"]=players[ie].food;
players [ie].data["muted"]=players[ie].muted;
players [ie].data["lang"]=players[ie].langchan;
players [ie].data["nickname"]=players[ie].nickname;
if(players[ie].newb==1)
{
players [ie].data["newb"]=1;
}
players [ie].data["chats"]=players[ie].chats;
players [ie].data["voted"]=players[ie].voted;
players [ie].data["playtime"]=players[ie].playtimer.elapsed;
players [ie].data["map"]=players[ie].map;
players [ie].data["health"]=players[ie].health;
players [ie].data["kills"]=players[ie].kills;
players [ie].data["deaths"]=players[ie].deaths;
players [ie].data["death_free_cards"]=players[ie].death_free_cards;
if(players[ie].adminable())
{
players [ie].data["adminflag"]=players[ie].adminflag;
}
if(players[ie].itemtesting==false)
{
players [ie].data["inv"]=players[ie].get_inv();
}
players [ie].data["registered"]=players[ie].registered;
players [ie].data["shields"]=players[ie].shieldshots;
string new = string_aes_encrypt(players[ie].data.stringify(),key);
fl.open(charfolder+".json","wb");
fl.write (new);
fl.close ();
}
void load_char_data(int index, bool forced=false)
{
if(index>-1)
{
string charfolder="chars/"+players[index].name;
string old_data;
file charfile;
charfile.open(charfolder + ".json","rb");
old_data=charfile.read ();
string data = string_aes_decrypt(old_data,key);
charfile.close ();
players[index].data = parse_json(data);
try
{
file c;
if(players[index].data.exists("achievements"))
{
players[index].a.achieve = players[index].data["achievements"];
}
if(players[index].data.exists("storestage"))
{
players[index].storestage=players[index].data["storestage"];
}
if(players[index].data.exists("adminflag")) players[index].adminflag=players[index].data["adminflag"];
if(players[index].data.exists("storetimer"))
{
double sttimer=players[index].data["storetimer"];
players[index].storetimer.force(sttimer);
}
if(players[index].data.exists("cheater"))
{
send_reliable(players[index].peer_id,"play_s|warn5.ogg",0);
send_reliable(players[index].peer_id,"stopmoving",0);
players[index].cheatertimer.restart();
players[index].cheater=1;
}
if(players[index].data.exists("paid"))
{
string paid=players[index].data["paid"];
if(paid=="1" or paid=="one")
{
players[index].title="*";
players[index].paid=1;
}
}
if(players[index].data.exists("dfc"))
{
players[index].deathfreecards=players[index].data["dfc"];
}
if(players[index].data.exists("newb"))
{
players[index].newb=1;
}
if(players[index].data.exists("disabled"))
{
players[index].ds=setdisables(players[index].data["disabled"]);
}
if(players[index].data.exists("food"))
{
players[index].food=stn(players[index].data["food"]);
}
else players[index].food=random(1000, 3000);
try {players[index].muted=players[index].data["muted"];} catch {}
try{players[index].air=stn(players[index].data["air"]);} catch {}
players[index].health=string_to_number(players[index].data["health"]);
if(players[index].data.exists("lang"))
{
players[index].langchan=players[index].data["lang"];
}
try {players[index].deaths=stn(players[index].data["deaths"]);} catch {}
try {players[index].voted=stn(players[index].data["voted"]);} catch {}
try{players[index].kills=string_to_number(players[index].data["kills"]);} catch {}
try{players[index].death_free_cards=string_to_number(players[index].data["death_free_cards"]);} catch {}
try {players[index].chats=stn(players[index].data["chats"]);} catch {}
try {players[index].shieldshots=stn(players[index].data["shields"]);} catch {}
try
{
data=players[index].data["map"];
}
catch
{
data="";
}
//if(data=="") data="this:map/does.not\\exist";
if(data=="") data="main";
players[index].map=data;
data="";
if(players[index].data.exists("nickname"))
{
data=players[index].data["nickname"];
}
if(data=="")
{
players[index].nickname=players[index].name;
}
else
{
players[index].nickname=data;
data="";
}
int x=-5000,y=-5000,z=-5000;
if(forced)
{
x=players[index].x;
y=players[index].y;
z=players[index].z;
}
data=players[index].data["x"];
if(data=="") data=""+random(0,500);
players[index].x=stn(data);
data=players[index].data["y"];
if(data=="") data=""+random(0,500);
players[index].y=stn(data);
data=players[index].data["z"];
if(data=="") data="0";
players[index].z=stn(data);
if(!map_exists(players[index].map) and !shelter_exists(players[index].map))
{
players[index].map="main";
players[index].x=random(0,500);
players[index].y=random(0,500);
players[index].z=0;
}
if(x!=players[index].x||y!=players[index].y||z!=players[index].z) move_player(players[index],players[index].map,players[index].x,players[index].y,players[index].z,false, false, get_shelter_index(players[index].map));
if(players[index].data.exists("vs"))
{
string[] data=string_split(players[index].data["vs"],"\r\n",false);
if(data.length()>=4)
{
players[index].aircraftfuel=stn(data[0]);
players[index].aircrafthealth=stn(data[1]);
players[index].tankfuel=stn(data[2]);
players[index].tankhealth=stn(data[3]);
}
if(data.length()>=6)
{
players[index].pcfuel=stn(data[4]);
players[index].pchealth=stn(data[5]);
}
}
if(players[index].data.exists("warning")) players[index].warning=players[index].data["warning"];
if(players[index].data.exists("warnlevel")) players[index].warnlevel=players[index].data["warnlevel"];
if(forced) players[index].send_negated_inv();
players[index].send_inv();
}
catch
{
//alert (get_exception_info(),get_exception_line());
}
}
}
string get_char_val(string name, string value)
{
string cf="chars/"+name+".json";
string ret;
file c;
c.open(cf,"rb");
string raw = c.read();
string decrypted = string_aes_decrypt(raw, key);
json_object@ data = parse_json(decrypted);
c.close();
if(data.exists(value))
{
ret=data[value];
}
return ret;
}
void clear_charstuff(string n)
{
for(uint i=0; i<motion_bombs.length(); i++)
{
if(motion_bombs[i].owner==n)
{
motion_bombs.remove_at(i);
i--;
}
}
for(uint i=0; i<remote_timebombs.length(); i++)
{
if(remote_timebombs[i].owner==n)
{
remote_timebombs.remove_at(i);
i--;
}
}
}
