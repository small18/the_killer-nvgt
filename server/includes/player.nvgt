{
inventory.set(item,amount);
}
else
{
inventory.get(item,a);
if (a+amount<=0)
inventory.delete(item);
else
{
int64 b=(a+amount);
//inventory.delete(item);
inventory.set(item,b);
}
}
this.neg_inv_check();
