move_objs_to(players[i].x, players[i].y, players[i].z, players[i].map, random(0, 130));
send_reliable(players[i].peer_id,"startmoving",0);
}
if(players[i].enemygrabbing==true and players[i].enemygrabbingtimer.elapsed>=25000)
{
players[i].enemygrabbing=false;
play("itemgrabberfire",players[i].x,players[i].y,players[i].z,players[i].map);
send_reliable(0,"distsound|itemgrabberdist|"+players[i].x+"|"+players[i].y+"|"+players[i].z+"|"+players[i].map,0);
