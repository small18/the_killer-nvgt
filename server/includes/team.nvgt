void transmit(string t, bool chat=false, int channel=2)
{
for(uint i=0; i<teammembers.length(); i++)
{
int dex=get_player_index_from(teammembers[i]);
if(dex>-1)
{
if(chat==true)
{
send_reliable(players[dex].peer_id,"teammessage|"+t,1);
}
else
send_reliable(players[dex].peer_id,t,channel);
}
}
}
void add_member(string name,bool message=true)
{
int index=get_player_index_from(name);
if(index>-1)
{
players[index].teamname=teamname;
send_reliable(0,"update_player_teamname|"+players[index].name+"|"+teamname,0);
if(message)
{
transmit("play_s|teamadd.ogg",false,0);
transmit(name+" was added to your team!");
send_reliable(players[index].peer_id,"You have been added to the "+teamname+" team!",2);
send_reliable(players[index].peer_id,"play_s|teamwelcome.ogg",0);
}
for(uint x=0; x<security_bombs.length(); x++)
{
if(security_bombs[x].owner==players[index].name)
{
security_bombs[x].teamname=players[index].teamname;
}
}
players[index].data["team"]=players[index].teamname;
if(buffermembers.find(name)>-1) buffermembers.remove_at(buffermembers.find(name));
if(!is_member(name)) teammembers.insert_last(name);
}
}
void destruct(bool message=true)
{
if(message)
{
transmit("play_s|teamkicked.ogg",false,0);
transmit("this team has been canceled!");
}
if(teammembers.length () >0)
{
do
{
remove_member(teammembers[0],true,false);
}
while(teammembers.length()>0);
}
for(uint i=0; i<buffermembers.length (); i++)
{
file f;
f.open ("chars/"+buffermembers[i]+".json","rb");
json_object@ js = parse_json(f.read ());
f.close();
js.remove ("team");
f.open ("chars/"+buffermembers[i]+".json","wb");
f.write (js.stringify());
f.close ();
}
buffermembers.resize(0);
}
}
void teamloop()
{
for(uint i=0; i<teams.length (); i++)
{
if(teams[i].points<=0)
{
teams[i].transmit("This team has ran out of points and is now being canceled");
teams[i].destruct(false);
send_reliable(0,"The "+teams[i].teamname+" team ran out of points and has been canceled!",2);
}
if(teams[i].pointstimer.elapsed>60000)
{
teams[i].pointstimer.restart();
teams[i].points-= 20;
}
if(teams[i].teammembers.length ()<=0&&teams[i].buffermembers.length ()<=0)
{
json_array @jsa = parse_json(file_get_contents("teams/teams.json"));
if(@jsa==null) return;
for(uint j = 0; j < jsa.length(); j++)
{
json_object@ js=parse_json(jsa[j]);
if(@js==null) continue;
if(js["name"]==teams[i].teamname) jsa.remove(j);
}
file_put_contents("teams/teams.json",jsa.stringify());
teams.remove_at(i);
return;
}
teams[i].buffercheck();
}
}
int is_in_team(string n)
{
for(uint t=0; t<teams.length(); t++)
{
if(teams[t].teammembers.find(n)>-1 or teams[t].buffermembers.find(n)>-1) return t;
}
return -1;
}
void create_team(string t, string tl)
{
team t1(t, tl);
teams.insert_last(t1);
int index = get_player_index_from(tl);
if(index>-1)
{
send_reliable(0,"update_player_teamname|"+tl+"|"+t,0);
}
}
int get_team_index(string name)
{
for(uint i=0; i<teams.length(); i++)
{
if(teams[i].teamname==name)
return i;
}
return -1;
}
bool team_exists(string t)
{
for(uint i=0; i<teams.length(); i++)
{
if(teams[i].teamname==t)
{
return true;
}
}
return false;
}
void load_team(string t)
{
string tl,tpw,tm,bm;
double points;
double kls,mxm;
/*
savedata tsd("teams/"+t+".team","tk_team");
tsd.load();
if(tsd.d.exists("leader"))
tl=tsd.read("leader");
if(tsd.d.exists("teampassword"))
tpw=tsd.read("teampassword");
if(tsd.d.exists("teampoints"))
points=tsd.readn("teampoints");
if(tsd.d.exists("maxmembers"))
mxm=tsd.readn("maxmembers");
if(tsd.d.exists("teammembers"))
tm=tsd.read("teammembers");
if(tsd.d.exists("buffermembers"))
bm=tsd.read("buffermembers");
if(tsd.d.exists("teamkills"))
kls=tsd.readn("teamkills");
*/
file f;
f.open("teams/teams.json","rb");
string team_data = f.read();
f.close();
json_array@ json_a = parse_json(team_data);
if(@json_a==null) return;
json_object@ json_o = null;
try
{
for(uint i = 0; i < json_a.size(); i++)
{
@json_o = json_a[i];
if (json_o["name"] != t) continue;
}
if(json_o["name"] != t) return;
if(json_o.exists("leader"))
tl = json_o["leader"];
create_team(t,tl);
int x=get_team_index(t);
//teams[x].teamleader=tl;
if(json_o.exists("teammembers"))
{
json_array@ temp=parse_json(json_o["teammembers"]);
if(@temp==null) return;
if(temp.size()>0)
{
for(uint i = 0; i < temp.size(); i++)
{
teams[x].teammembers.insert_last(temp[i]);
}
}
}
for(uint i=0; i<teams[x].teammembers.length (); i++)
{
if(teams[x].teammembers[i]=="" or teams[x].teammembers[i]==" ")
{
teams[x].teammembers.remove_at(i);
i--;
}
}
if(json_o.exists("maxmembers"))
teams[x].maxmembers=json_o["maxmembers"];
if(json_o.exists("points"))
teams[x].points=json_o["points"];
if(json_o.exists("buffermembers"))
{
json_array@ temp=parse_json(json_o["buffermembers"]);
if(@temp==null) return;
if(temp.size()>0)
{
for(uint i = 0; i < temp.size(); i++)
{
teams[x].buffermembers.insert_last(temp[i]);
}
}
}
for(uint i=0; i<teams[x].buffermembers.length (); i++)
{
if(teams[x].buffermembers[i]=="" or teams[x].buffermembers[i]==" ")
{
teams[x].buffermembers.remove_at(i);
i--;
}
}
if(json_o.exists("password"))
teams[x].password=json_o["password"];
teams[x].buffercheck();
if(json_o.exists("kills"))
teams[x].teamkills=json_o["kills"];
}
catch
{

}
}
void load_all_teams()
{
if (!file_exists("teams/teams.json")) return;
file f;
f.open("teams/teams.json","rb");
string data = f.read();
f.close();
if(data.is_empty()) return;
try
{
json_array@ json_a = parse_json(data);
if(@json_a==null) return;
json_object@ json_o = null;
for(uint i = 0; i < json_a.size(); i++)
{
@json_o = json_a[i];
load_team(json_o["name"]);
}
}
catch
{

}
}
bool is_part_of_team(string playername, string teamname)
{
int ti=get_team_index(teamname);
if(ti<0) return false;
int pi=get_player_index_from(playername);
if(pi<0) return false;
return teams[ti].is_member(playername);
}
bool are_teamed(string pn1, string pn2)
{
int x1=get_player_index_from(pn1);
int x2=get_player_index_from(pn2);
if(x1==-1||x2==-1) return false;
int tx1=is_in_team(pn1);
int tx2=is_in_team(pn2);
if(tx1==-1||tx2==-1) return false;
if(tx1==tx2 or teams[tx1].is_member(pn2) or teams[tx2].is_member(pn1)) return true;
return false;
}
void team_save()
{
json_object json_o;
json_array json_a;
for(uint i = 0; i < teams.length(); i++)
{
json_o.set("name",teams[i].teamname);
json_o.set("password",teams[i].password);
json_o.set("leader",teams[i].teamleader);
json_o.set("maxmembers",teams[i].maxmembers);
json_o.set("kills",teams[i].teamkills);
json_o.set("points",teams[i].points);
json_array teammem;
for(uint j = 0; j < teams[i].teammembers.length(); j++)
{
teammem.add(teams[i].teammembers[j]);
}
json_o.set("teammembers",teammem);
json_array bufmem;
for(uint j = 0; j < teams[i].buffermembers.length(); j++)
{
bufmem.add(teams[i].buffermembers[j]);
}
json_o.set("buffermembers",bufmem);
json_a.add(json_o);
}
if (!directory_exists("teams")) directory_create("teams");
file f;
f.open("teams/teams.json","wb");
f.write(json_a.stringify());
f.close();
}
