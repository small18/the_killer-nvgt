for(uint v=0; v<shelters.length (); v++)
{
if(are_teamed(weapons[j].p.name,shelters[v].owner)) continue;
if(get_3d_distance(weapons[j].x,weapons[j].y,weapons[j].z,shelters[v].x,shelters[v].y,shelters[v].z)<=weapons[j].type.spread&&shelters[v].map==weapons[j].map and weapons[j].p.name!=shelters[v].owner)
{
string t="";
if(!weapons[j].type.bullet) t=weapons[j].type.name;
if(weapons[j].type.name=="grenade")
{
//t="";
spawn_grenade(shelters[v].x,shelters[v].y,shelters[v].z,shelters[v].facing,shelters[v].map,weapons[j].p.name);
}
if(weapons[j].type.name=="rocket_launcher")
{
spawn_rocket(shelters[v].x,shelters[v].y,shelters[v].z,shelters[v].facing,shelters[v].map,weapons[j].p.name);
}
if(weapons[j].type.name=="rpg7")
{
spawn_rpg(shelters[v].x,shelters[v].y,shelters[v].z,shelters[v].facing,shelters[v].map,weapons[j].p.name);
}
if(weapons[j].type.name=="gp30")
{
spawn_gp(shelters[v].x,shelters[v].y,shelters[v].z,shelters[v].facing,shelters[v].map,weapons[j].p.name);
}
if(weapons[j].type.name=="ags30")
{
spawn_ags(shelters[v].x,shelters[v].y,shelters[v].z,shelters[v].facing,shelters[v].map,weapons[j].p.name);
}
if(weapons[j].type.name=="m79_grenade_launcher")
{
spawn_grenade(shelters[v].x,shelters[v].y,shelters[v].z,shelters[v].facing,shelters[v].map,weapons[j].p.name);
}
shelters[v].hit(random(weapons[j].type.min_damage,weapons[j].type.max_damage),weapons[j].p.name+"'s "+weapons[j].type.name,t);
if(@weapons[j].p!=null)
{
send_reliable(weapons[j].p.peer_id,"play_s|weaponping.ogg",0);
if(weapons[j].type.name=="artillery") send_reliable(weapons[j].p.peer_id,"hit "+cn2n(shelters[v].owner)+"'s shelter",2);
}
hit=true;
}
}
for(uint v=0; v<vs.length (); v++)
{
if(get_2d_distance(weapons[j].x,weapons[j].y,vs[v].x,vs[v].y)<=weapons[j].type.spread&&vs[v].map==weapons[j].map&&vs[v].owner!=weapons[j].p.name and ((vs[v].z>=weapons[j].z&&(vs[v].z<=(weapons[j].z+8))&&weapons[j].type.name!="artillery")||(vs[v].z>=weapons[j].z&&(vs[v].z<=(weapons[j].z+10))&&weapons[j].type.name=="artillery")))
{
string t="";
if(!weapons[j].type.bullet) t=weapons[j].type.name;
if(weapons[j].type.name=="grenade")
{
t="";
spawn_grenade(vs[v].x,vs[v].y,vs[v].z,vs[v].facing,vs[v].map,weapons[j].p.name);
}
if(weapons[j].type.name=="rocket_launcher")
{
spawn_rocket(vs[v].x,vs[v].y,vs[v].z,vs[v].facing,vs[v].map,weapons[j].p.name);
}
if(weapons[j].type.name=="rpg7")
{
spawn_rpg(vs[v].x,vs[v].y,vs[v].z,vs[v].facing,vs[v].map,weapons[j].p.name);
}
if(weapons[j].type.name=="gp30")
{
spawn_gp(vs[v].x,vs[v].y,vs[v].z,vs[v].facing,vs[v].map,weapons[j].p.name);
}
if(weapons[j].type.name=="ags30")
{
spawn_ags(vs[v].x,vs[v].y,vs[v].z,vs[v].facing,vs[v].map,weapons[j].p.name);
}
if(weapons[j].type.name=="m79_grenade_launcher")
{
spawn_grenade(vs[v].x,vs[v].y,vs[v].z,vs[v].facing,vs[v].map,weapons[j].p.name);
}
vs[v].hit(random(weapons[j].type.min_damage,weapons[j].type.max_damage),weapons[j].p.name+"'s "+weapons[j].type.nickname.is_empty()==false ? weapons[j].type.nickname : weapons[j].type.name);

if(@weapons[j].p!=null)
{
send_reliable(weapons[j].p.peer_id,"play_s|"+(are_teamed(weapons[j].p.name, vs[v].owner)?"weaponpingteam":"weaponping")+".ogg",0);
if(weapons[j].type.name=="artillery") send_reliable(weapons[j].p.peer_id,"hit "+cn2n(vs[v].owner,true),2);
}
hit=true;
}
}
if(hit) {
 weapons.remove_at(j);
 j--;
 continue;
}
}
}
}
}
void spawn_weapon(double x, double y, double z, double dir, string type, string map,player@p1)
{
if(@p1==null) return;
weapon_data@ wd = return_wdata(type);
if(@wd==null) return;
weapon w1(x, y, z, dir, wd, map, p1);
weapons.insert_last(w1);
}
