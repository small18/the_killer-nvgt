for(uint x=0; x<players.length(); x++)
{
if(in_vehicle(players[x].name)>-1 or players[x].is_dead or players[x].invinsible or players[x].newb==1) continue;
if(get_3d_distance(rx, ry, weapons[j].z, players[x].x, players[x].y, players[x].z)<=weapons[j].type.spread and players[x].map==weapons[j].map)
{
if(weapons[j].type.hit_owner==false&&weapons[j].p.name==players[x].name) continue;
send_reliable(weapons[j].p.peer_id,"play_s|"+(are_teamed(weapons[j].p.name, players[x].name)?"weaponpingteam":"weaponping")+".ogg",0);
if(weapons[j].type.name=="artillery") send_reliable(weapons[j].p.peer_id,"hit "+players[x].nickname,2);
hit=true;
if(weapons[j].type.name!="grenade" or weapons[j].type.name!="sticky_bomb" or weapons[j].type.name!="fists" or weapons[j].type.name!="feet")
{
if(players[x].shielded and random(0,100)>weapons[j].type.shield_chance)
{
players[x].playsound("shieldhit"+random(1,2));
players[x].shieldshots-=random(weapons[j].type.min_shield_hits,weapons[j].type.max_shield_hits);
players[x].statchangetimer.restart();
}
else
{
if(weapons[j].type.bullet) play("body"+random(1,3),players[x].x,players[x].y,players[x].z,players[x].map);
else {
string hitsound;
if(weapons[j].type.hit_sounds==0) hitsound=weapons[j].type.name+"hit";
else
hitsound=weapons[j].type.name+"hit"+random(1,weapons[j].type.hit_sounds);
play(hitsound,players[x].x,players[x].y,players[x].z,players[x].map);
}
int inpact=random(weapons[j].type.min_damage,weapons[j].type.max_damage);
if(inpact>0) players[x].hit(weapons[j].type.min_damage,weapons[j].type.max_damage);
if(weapons[j].type.name!="artillery"&&weapons[j].type.name!="admingun") players[x].should_subtract=true;
else players[x].should_subtract=false;
}
if(weapons[j].type.stunning)
{
players[x].stun(weapons[j].type.stun_time,false,false);
}
players[x].hitby=weapons[j].p.name+"'s "+weapons[j].type.name;
if(!weapons[j].type.nickname.is_empty()) players[x].hitby=weapons[j].p.name+"'s "+weapons[j].type.nickname;
}
if(weapons[j].type.name=="sticky_bomb")
{
spawn_stickybomb(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name,players[x].name);
}
if(weapons[j].type.name=="grenade")
{
spawn_grenade(players[x].x,players[x].y,players[x].z,players[x].facing,players[x].map,weapons[j].p.name);
}
if(weapons[j].type.name=="rocket_launcher")
{
spawn_rocket(players[x].x,players[x].y,players[x].z,players[x].facing,players[x].map,weapons[j].p.name);
}
if(weapons[j].type.name=="rpg7")
{
spawn_rpg(players[x].x,players[x].y,players[x].z,players[x].facing,players[x].map,weapons[j].p.name);
}
if(weapons[j].type.name=="gp30")
{
spawn_gp(players[x].x,players[x].y,players[x].z,players[x].facing,players[x].map,weapons[j].p.name);
}
if(weapons[j].type.name=="ags30")
{
spawn_ags(players[x].x,players[x].y,players[x].z,players[x].facing,players[x].map,weapons[j].p.name);
}
if(weapons[j].type.name=="m79_grenade_launcher")
{
spawn_grenade(players[x].x,players[x].y,players[x].z,players[x].facing,players[x].map,weapons[j].p.name);
}
if(weapons[j].type.name=="cyanide_pistol")
{
players[x].cyanide=true;
players[x].cyanidelosses=0;
players[x].cyanidetimer.restart();
}
if(weapons[j].type.name=="poison_dart")
{
players[x].playsound("poisonstart");
players[x].poisoned=true;
players[x].poisonlosses=0;
players[x].poisontimer.restart();
}
if(weapons[j].type.name=="health_dart")
{
players[x].playsound("stun_darthit");
if(players[x].warping&&players[x].warpstage==0)
{
players[x].playsound("wpfail");
players[x].warping=false;
send_reliable(players[x].peer_id,"startmoving",0);
}
int val=random(400,4000);
weapons[j].p.health+=val;
players[x].health-=val;
}
if(weapons[j].type.name=="stun_dart")
{
players[x].hitby=weapons[j].p.name+"'s stun dart";
players[x].stun(5000,true,true,5000);
if(players[x].warping&&players[x].warpstage==0)
{
players[x].playsound("wpfail");
players[x].warping=false;
}
}
}
}
if(weapons[j].type.name!="artillery" and weapons[j].type.name!="grenade")
{
for(uint x=0; x<objs.length(); x++)
{
if(get_3d_distance(rx, ry, weapons[j].z, objs[x].x, objs[x].y, objs[x].z)<=weapons[j].type.spread and objs[x].map==weapons[j].map)
{
play("obj_break"+random(1,3),objs[x].x,objs[x].y,objs[x].z,objs[x].map);
remove_obj(x);
hit=true;
}
}
for(uint x=0; x<horbs.length(); x++)
{
if(get_3d_distance(rx, ry, weapons[j].z, horbs[x].x, horbs[x].y, horbs[x].z)<=weapons[j].type.spread and horbs[x].map==weapons[j].map)
horbs[x].shoot();
}
}
