string wnames="fists feet";
weapon@[]weapons(0);
class weapon {
double x,y,z;
int dir=0;
timer speed_timer;
int distance = 0;
weapon_data@ type = null;
string map;
player@p;
vector maxcoords;
weapon(double bx, double by, double bz, double bdir, weapon_data@ btype, string bmap,player@p2)
{
x=bx;
y=by;
z=bz;
dir=bdir;
@type=btype;
map=bmap;
maxcoords=get_max_values(map);
@p=p2;
}
}
void weaponloop()
{
for(uint j=0; j<weapons.length(); j++)
{
if(@weapons[j].type==null)
{
weapons.remove_at(j);
j--;
continue;
}
if(weapons[j].speed_timer.elapsed>=weapons[j].type.speed_time)
{
weapons[j].speed_timer.restart();
vector wr;
wr=move(weapons[j].x,weapons[j].y,weapons[j].dir);
weapons[j].x=wr.x;
weapons[j].y=wr.y;
int rx=round(weapons[j].x, 0);
int ry=round(weapons[j].y, 0);
if(weapons[j].distance > weapons[j].type.range or string_left(get_tile_at(rx,ry,weapons[j].z,weapons[j].map),4)=="wall" or rx>weapons[j].maxcoords.x or ry>weapons[j].maxcoords.y or rx<0 or ry<0)
{
if(weapons[j].type.bullet)
{
play("rico"+random(1, 5), rx, ry, weapons[j].z, weapons[j].map);
weapons.remove_at(j);
j--;
continue;
}
else if(weapons[j].type.name=="stun_dart" or weapons[j].type.name=="health_dart" or weapons[j].type.name=="poison_dart")
{
play("stun_dartdrop",weapons[j].x,weapons[j].y,weapons[j].z,weapons[j].map);
weapons.remove_at(j);
j--;
continue;
}
else if(weapons[j].type.name=="sticky_bomb")
{
spawn_stickybomb(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name,"");
weapons.remove_at(j);
j--;
continue;
}
else if(weapons[j].type.name=="grenade")
{
spawn_grenade(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
weapons.remove_at(j);
j--;
continue;
}
else if(weapons[j].type.name=="m79_grenade_launcher")
{
spawn_grenade(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
weapons.remove_at(j);
j--;
continue;
}
else if(weapons[j].type.name=="rocket_launcher")
{
spawn_rocket(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
weapons.remove_at(j);
j--;
continue;
}
else if(weapons[j].type.name=="rpg7")
{
spawn_rpg(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
weapons.remove_at(j);
j--;
continue;
}
else if(weapons[j].type.name=="gp30")
{
spawn_gp(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
weapons.remove_at(j);
j--;
continue;
}
else if(weapons[j].type.name=="ags30")
{
spawn_ags(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
weapons.remove_at(j);
j--;
continue;
}
else
{
weapons.remove_at(j);
j--;
continue;
}
weapons[j].distance++;
}
bool hit=false;
string sendtext="";

if(@weapons[j].p!=null)
{
/*
if(string_left(get_tile_at(rx,ry,weapons[j].z,weapons[j].map),4)=="wall" or rx>weapons[j].maxcoords.x or ry>weapons[j].maxcoords.y or rx<0 or ry<0)
{
if(weapons[j].bullet) play("rico"+random(1, 5), rx, ry, weapons[j].z, weapons[j].map);
else if(weapons[j].type=="sticky_bomb")
