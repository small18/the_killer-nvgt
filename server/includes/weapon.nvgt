play("helicopterhit"+random(1, 9), rx, ry, weapons[j].z, weapons[j].map);
helicopters[x].hitby=weapons[j].p.name+"'s "+(weapons[j].type.nickname.is_empty()==false ? weapons[j].type.nickname : weapons[j].type.name);
helicopters[x].hitby=weapons[j].p.name+"'s "+(weapons[j].type.name=="artillery1" ? "armored tank" : weapons[j].type.name);
hit=true;
if(weapons[j].type.name=="grenade")
{
spawn_grenade(helicopters[x].x,helicopters[x].y,helicopters[x].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
break;
}
if(weapons[j].type.name=="m79_grenade_launcher")
{
spawn_grenade(helicopters[x].x,helicopters[x].y,helicopters[x].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
break;
}
