obj@[] objs(0);
class obj
{
int x;
int y;
int z;
string name;
string map;
timer beeptimer, timeouttimer;
int64 amount;
string id;
bool dropped=false;
obj(int ox, int oy, int oz, string omap, string oname, int64 oa=1, bool dropped=true, string oid="")
{
map=omap;
x=ox;
y=oy;
z=oz;
name=oname;
amount=oa;
id=oid;
this.dropped=dropped;
}
}
void objloop()
{
obj@[] objs1;
objs1=objs;
for(uint i=0;i<objs1.length();i++)
{
if (@objs1[i]==null)
{
continue;
}
/*
if(objs[i].beeptimer.elapsed>=750)
{
objs[i].beeptimer.restart();
play("obj", objs[i].x, objs[i].y, objs[i].z, objs[i].map,-1,true,false);
}
*/
if(objs1[i].timeouttimer.elapsed>=120000)
{
play("obj_break"+random(1,3),objs[i].x,objs[i].y,objs[i].z,objs[i].map);
if (objs.length() < i) return;
remove_obj(i);
i--;
continue;
}
player@[] players1 = players;
for(uint x=0; x<players1.length(); x++)
{
if(x>players.length()) break;
if(players1[x].invinsible==true or players1[x].is_dead==true) continue;
if(get_3d_distance(objs1[i].x,objs1[i].y,objs1[i].z,players1[x].x,players1[x].y,players1[x].z)<=4 and players1[x].map==objs1[i].map)
{
play("objget", objs[i].x, objs[i].y, objs[i].z, objs[i].map);
objgrabs++;
if(objs1[i].name=="coin_pack")
{
send_reliable(players1[x].peer_id,"A pack of coins!",2);
players1[x].give("coin",random(20,80));
}
else if(objs1[i].name=="remote_timebomb_controller")
{
if(players1[x].get_item_count("remote_timebomb_controller")>0)
{
send_reliable(players1[x].peer_id,"remote timebomb",2);
players1[x].give("remote_timebomb",1);
}
else
{
send_reliable(players1[x].peer_id,"A remote timebomb controller!",2);
players1[x].give("remote_timebomb_controller",1);
}
}
else if(objs1[i].name=="remote_gun_controller")
{
if(players1[x].get_item_count("remote_gun_controller")>0)
{
send_reliable(players1[x].peer_id,"remote gun",2);
players1[x].give("remote_gun",1);
}
else
{
send_reliable(players1[x].peer_id,"a remote gun controller!",2);
players1[x].give("remote_gun_controller",1);
}
}
else if(objs1[i].name=="gas_mask")
{
if(players1[x].get_item_count("gas_mask")>0)
{
send_reliable(players1[x].peer_id,"air canister",2);
players1[x].give("air_canister",1);
}
else
{
send_reliable(players1[x].peer_id,"A gas mask!",2);
players1[x].give("gas_mask",1);
}
}
else if(objs1[i].name=="bike")
{
string items=players1[x].get_inv();
if(inv_item_number(items, "bike")>0)
{
send_reliable(players1[x].peer_id,"You already have one, so you get a bike helmet",2);
players1[x].give("bike_helmet",1);
}
else
{
send_reliable(players1[x].peer_id,"a bike!",2);
players1[x].give("bike",1);
}
}
else if(objs1[i].name=="ammo")
{
int tmpint=random(15,50);
string temp=get_guns_data()[random(0,get_guns_data().length()-1)].name;
send_reliable(players1[x].peer_id,tmpint+" "+temp+" ammo!",2);
players1[x].give("ammo_"+temp,tmpint);
}
else if(objs1[i].name=="antibiotic_pack")
{
players1[x].give("antibiotic",20);
send_reliable(players1[x].peer_id,"play_s|gift.ogg",0);
send_reliable(players1[x].peer_id,"an antibiotic pack!",2);
}
else if(objs1[i].name=="mini_antibiotic_pack")
{
players1[x].give("antibiotic",5);
send_reliable(players1[x].peer_id,"play_s|gift.ogg",0);
send_reliable(players1[x].peer_id,"a mini antibiotic pack!",2);
}
else if(objs1[i].name=="ultra_antibiotic_pack")
{
players1[x].give("antibiotic",50);
send_reliable(players1[x].peer_id,"play_s|gift.ogg",0);
send_reliable(players1[x].peer_id,"an ultra antibiotic pack!",2);
}
else if(objs1[i].name=="health_pack")
{
if(players1[x].health<50000)
{
send_reliable(players1[x].peer_id, "Extra health!", 2);
players1[x].playsound("extrahealth");
players1[x].health+=random(1000,3000);
players1[x].oldhealth=players1[x].health;
}
else
{
send_reliable(players1[x].peer_id,"antibiotic",2);
players1[x].give("antibiotic",1);
}
}
else if(objs1[i].name=="ultrabomb_locator")
{
if(players1[x].get_item_count("ultrabomb_locator")>0 and !objs[i].dropped)
{
send_reliable(players1[x].peer_id, "ultrabomb", 2);
players1[x].give("ultrabomb", 1);
}
else
{
send_reliable(players1[x].peer_id, "ultrabomb locator", 2);
players1[x].give("ultrabomb_locator", 1);
}
}
else
{
if(objs[i].amount==1) send_reliable(players1[x].peer_id, string_replace(objs[i].name,"_"," ",true), 2);
else send_reliable(players1[x].peer_id,objs[i].amount+" "+string_replace(objs[i].name,"_"," ",true)+"s", 2);
players1[x].give(objs[i].name,objs[i].amount);
}
remove_obj(i);
break;
}
}
}
}
void spawn_obj(int x, int y, int z, string map, string name, int64 amount=1,bool dropped=false,string id=object_stamp.elapsed+random(0,9))
{
obj i1(x,y,z,map, name,amount,dropped,id);
objspawns++;
objs.insert_last(i1);
send_reliable(0,"spawn_obj|"+x+"|"+y+"|"+z+"|"+map+"|"+name+"|"+amount+"|"+id,0);
}
void spawn_rand_obj(int minx, int maxx, int miny, int maxy, int minz, int maxz, string map, string[] choices)
{
int x,y,z;
string tile;
do
{
x=random(minx,maxx);
y=random(miny,maxy);
z=random(minz,maxz);
tile=get_tile_at(x,y,z,map);
//net_loop();
}
while(tile==""||string_left(tile,4)=="wall");
spawn_obj(x,y,z,map,choices[random(0,(choices.length()-1))]);
}
void move_all_objs_to(int x, int y, int z, string map)
{
string sendtext="update_objs|";
for(uint i=0; i<objs.length(); i++)
{
if(objs[i].map!="main") continue;
objs[i].x=x;
objs[i].y=y;
objs[i].z=z;
objs[i].map=map;
sendtext+=objs[i].id+"|"+objs[i].x+"|"+objs[i].y+"|"+objs[i].z+"|"+objs[i].map;
if(i!=objs.length()-1) sendtext+="\r\n";
}
send_reliable(0,sendtext,0);
}
int get_nearest_item_at(int x, int y, int z, string map, string type)
{
int current_distance=-1;
int final_index=-1;
for(uint i=0; i<objs.length(); i++)
{
if(objs[i].map!=map and objs[i].name!=type) continue;
int dist=get_3d_distance(x, y, z, objs[i].x, objs[i].y, objs[i].z);
if(current_distance==-1)
{
current_distance=dist;
final_index=i;
}
else
{
if(dist<current_distance)
{
current_distance=dist;
final_index=i;
}
}
}
return final_index;
}

void remove_obj(int it)
{
send_reliable(0,"remove_obj|"+objs[it].id,0);
objs.remove_at(it);
}
int get_obj_index(string id)
{
for(uint i = 0; i < objs.length(); i++)
{
if(objs[i].id==id)
return i;
}
return -1;
}
void move_objs_to(int x, int y, int z, string map, int itemcount)
{
int objgrabs=0;
string sendtext="update_objs|";
for(uint i=0;i<objs.length();i++)
{
if(objs[i].map==map and objs[i].name!="item_grabber")
{
objs[i].x=x;
objs[i].y=y;
objs[i].z=z;
sendtext+=objs[i].id+"|"+objs[i].x+"|"+objs[i].y+"|"+objs[i].z+"|"+objs[i].map;
if(i!=objs.length()-1) sendtext+="\r\n";
objgrabs++;
}
if(objgrabs>itemcount) break;
}
send_reliable(0,sendtext,0);
}