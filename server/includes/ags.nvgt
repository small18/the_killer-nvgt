ags@[]agss(0);
class ags {
double x,y,z;
int dir=0;
bool explode=false;
int range=8;
int distance=0;
int mindammage=10000;
int maxdammage=50000;
string map;
string owner;
int spread=10;
ags(double gx, double gy, double gz, double gdir, string gmap, string gowner)
{
x=gx;
y=gy;
z=gz;
dir=gdir;
map=gmap;
owner=gowner;
}
}

void agsloop()
{
for(uint j=0; j<agss.length(); j++)
{
play("ags30explode",agss[j].x,agss[j].y,agss[j].z,agss[j].map);
send_reliable(0,"distsound|ags30explodedist|"+agss[j].x+"|"+agss[j].y+"|"+agss[j].z+"|"+agss[j].map,0);
for(uint s=0; s<shelters.length(); s++)
{
if(get_3d_distance(agss[j].x,agss[j].y,agss[j].z,shelters[s].x,shelters[s].y,shelters[s].z)<=agss[j].range&&shelters[s].map==agss[j].map)
shelters[s].hit(random(agss[j].mindammage,agss[j].maxdammage),agss[j].owner+"'s ags","ags30");
}
for(uint x=0; x<players.length(); x++)
{
if(in_vehicle(players[x].name)>-1 or players[x].newb==1 or players[x].is_dead or players[x].invinsible) continue;
if(get_3d_distance(agss[j].x,agss[j].y,agss[j].z,players[x].x,players[x].y,players[x].z)<=agss[j].range and players[x].map==agss[j].map)
{
players[x].hit(agss[j].mindammage,agss[j].maxdammage);
players[x].should_subtract=true;
players[x].hitby=agss[j].owner+"'s ags30";
players[x].playsound("stp429hit");
}
}
for(uint h = 0; h < helicopters.length(); h++)
{
if(get_3d_distance(agss[j].x,agss[j].y,agss[j].z,helicopters[h].x,helicopters[h].y,helicopters[h].z)<=agss[j].spread&&agss[j].map==helicopters[h].map)
{
helicopters[h].health-=random(agss[j].mindammage, agss[j].maxdammage);
play("helicopterhit"+random(1, 9), helicopters[h].x, helicopters[h].y, helicopters[h].z, helicopters[h].map);
helicopters[h].hitby=agss[j].owner+"'s ags";
}
}
for(uint r = 0; r < robots.length(); r++)
{
if (robots[r].state>=ROBOT_KILL or robots[r].map!=agss[j].map) continue;
if(get_3d_distance(agss[j].x,agss[j].y,agss[j].z,robots[r].x,robots[r].y,robots[r].z)<=agss[j].spread)
{
robots[r].hit(random(agss[j].mindammage,agss[j].maxdammage),"ags",agss[j].owner);
}
}
for (uint i2=0; i2<objs.length(); i2++)
{
if (get_3d_distance(agss[j].x,agss[j].y,agss[j].z,objs[i2].x,objs[i2].y,objs[i2].z)<=agss[j].range and objs[i2].map==agss[j].map)
{
play("obj_break"+random(1,3),objs[i2].x,objs[i2].y,objs[i2].z,objs[i2].map);
remove_obj(i2);
}
}
for (uint i2=0; i2<remguns.length(); i2++)
{
if (get_3d_distance(agss[j].x,agss[j].y,agss[j].z,remguns[i2].x,remguns[i2].y,remguns[i2].z)<=agss[j].range and remguns[i2].map==agss[j].map)
{
remguns[i2].health-=random(agss[j].mindammage,agss[j].maxdammage);
remguns[i2].hitby=agss[j].owner+"'s ags30";
play("remgunhit"+random(1, 3),remguns[i2].x,remguns[i2].y,remguns[i2].z,remguns[i2].map);
}
}
for(uint v=0; v<vs.length(); v++)
{
if(get_2d_distance(vs[v].x,vs[v].y,agss[j].x,agss[j].y)<=agss[j].range)
{
vs[v].hit(random(agss[j].mindammage,agss[j].maxdammage),agss[j].owner+"'s ags","ags30");
}
}
for(uint x=0; x<impact_bombs.length(); x++)
{
if(get_3d_distance(agss[j].x,agss[j].y,agss[j].z,impact_bombs[x].x,impact_bombs[x].y,impact_bombs[x].z)<=20 and agss[j].map==impact_bombs[x].map)
{
play("ibombhit"+random(1,3),impact_bombs[x].x,impact_bombs[x].y,impact_bombs[x].z,impact_bombs[x].map);
impact_bombs[x].health-=random(agss[j].mindammage,agss[j].maxdammage);
}
}
agss.remove_at(j);
j--;
continue;
}
}
void spawn_ags(double x, double y, double z, double dir, string map, string owner)
{
ags f1(x, y, z, dir, map, owner);
agss.insert_last(f1);
}
