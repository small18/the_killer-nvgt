if(index>-1)
{
if(players[index].hidden==0) send_reliable(0,"menusound "+players[index].x+" "+players[index].y+" "+players[index].z+" "+players[index].map+" "+players[index].name+" "+parsed[1],0);
}
}
else if(parsed[0]=="purchase" and parsed.length()>2)
{
