file f;
f.open ("prefs/server_state.dat","rb");
string data = string_aes_decrypt(f.read(),"ie,Acjtf^m;nj@6I02?(4D,F=&4JOm}74>mI9titQ`^;_vYT`:KaP8Ms~-qt)Rd@WhYbR/[<^9(r*B;W(![");
f.close ();
if (data=="")
{
return;
}
json_object@ js = parse_json(data);
if(!js.exists(key))
{
send_reliable(e.peer_id,"variable "+key+" not found",2);
}
else if(newval==-1)
{
send_reliable(e.peer_id,"variable "+key+" is currently "+js[key],2);
}
else
{
data_save(key,newval);
data_read();
send_reliable(e.peer_id,"variable "+key+" updated to "+newval,2);
}
}
