#include "includes/include.nvgt"
ip_locale l;
timestamp object_stamp;
network n;
network_event e;
mutex t_net_loop_mutex;
uint64 port = 10000;
bool netsetup;
dictionary sellitems;
int storex=0,storey=100,storez=0,fstorex=0,fstorey=100,fstorez=0;
string sellsend;
bool storemoving=false,fstorecoords=false;
int storeopened=1;
bool s_quit;
int filterstuff=1;
file fl;
int connections=0, disconnections=0;
bool beta=false;
timer savetimer;
int writeprefs=1;
int chatting=1;
int objgrabs=0, objspawns=0;
string adminlog;
int maxobjs=500;
string[] newbitems={"antibiotic","antibiotic_pack","mini_antibiotic_pack","antibiotic_pack","tk_ultra_health_potion"};
