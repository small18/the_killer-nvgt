else
*/
send_plus(players[index].peer_id,"play_step|"+(gpt.is_empty()?"[empty]":gpt)+"|"+players[index].x+"|"+players[index].y+"|"+players[index].z+"|"+players[index].map+"|"+players[index].name,0);
}
}
}
